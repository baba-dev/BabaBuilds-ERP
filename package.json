{
  "name": "bababuilds-erp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "prebuild:partner-kit": "npx tsx scripts/build-partner-kit.ts",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . && npm run check:kpi-impact",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run build",
    "check:locales": "node scripts/check-locales.js",
    "check:migrations": "bash scripts/check-migrations.sh",
    "admin:promote": "tsx scripts/make-admin.ts",
    "backfill": "tsx scripts/backfill.ts",
    "backfill:invoices": "npm run backfill",
    "check:kpi-impact": "node scripts/check-dashboard-kpi-coverage.js",
    "audit:routes": "node scripts/route-integrity-report.mjs",
    "validate:demos": "npx tsx scripts/validate-demo-templates.ts",
    "codex:quick": "bash scripts/codex-quick-check.sh",
    "ci:fast": "bash scripts/ci-fast.sh",
    "backfill:smtp-passwords": "node scripts/backfill-smtp-password-encryption.js",
    "backfill:primary-remittance": "npx ts-node prisma/backfill-primary-remittance.ts",
    "test:unit": "vitest run tests/sidebar/sidebar-rules.unit.test.ts",
    "test:integration": "vitest run tests/sidebar/mobile-drawer-parity.integration.test.ts",
    "test:smoke": "playwright test tests/smoke",
    "test:browser:install": "npx playwright install --with-deps chromium",
    "test:browser:smoke": "playwright test tests/smoke --project=chromium",
    "test:browser:headed": "playwright test tests/smoke --project=chromium --headed",
    "test:browser:ui": "playwright test tests/smoke --project=chromium --ui",
    "test:payments": "vitest run tests/payments && playwright test tests/payments",
    "test": "vitest run",
    "invoices:samples": "npx tsx scripts/render-sample-invoices.ts",
    "brochure:shell": "npx tsx scripts/generate-brochure-shell.ts",
    "brochure:api-appendix": "node scripts/generate-api-appendix.mjs",
    "brochure:stitch": "node scripts/stitch-brochure-appendix.mjs",
    "brochure:prepare": "npm run brochure:shell && npm run brochure:api-appendix && npm run brochure:stitch",
    "brochure:capture": "playwright test tests/brochure/capture-brochure.spec.ts --project=chromium",
    "brochure:pdf": "node scripts/brochure-render-pdf.mjs",
    "brochure:dist": "npm run brochure:prepare && npm run brochure:capture && npm run brochure:pdf"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@serwist/next": "^9.5.13",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/dompurify": "^3.2.0",
    "@types/jszip": "^3.4.1",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "clamscan": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.0",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^1.6.0",
    "html5-qrcode": "^2.3.8",
    "js-yaml": "^4.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.1",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "plaid": "^42.1.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "razorpay": "^2.9.8",
    "react": "19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.7",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^21.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/clamscan": "^2.4.1",
    "@types/exceljs": "^1.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pngjs": "^7.0.0",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "axios": "^1.15.2",
    "follow-redirects": "^1.16.0",
    "picomatch": "^4.0.4",
    "path-to-regexp": "^8.4.2",
    "defu": "^6.1.7",
    "effect": "^3.21.1",
    "hono": "^4.12.18",
    "@hono/node-server": "^1.19.14",
    "brace-expansion@^1": "1.1.14",
    "brace-expansion@^4": "^5.0.5",
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "postcss": "^8.5.10",
    "uuid": "^14.0.0"
  }
}
