{
  "name": "bababuilds-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . && npm run check:kpi-impact",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run build",
    "check:locales": "node scripts/check-locales.js",
    "check:kpi-impact": "node scripts/check-dashboard-kpi-coverage.js",
    "audit:routes": "node scripts/route-integrity-report.mjs",
    "validate:demos": "npx tsx scripts/validate-demo-templates.ts",
    "codex:quick": "bash scripts/codex-quick-check.sh",
    "backfill:smtp-passwords": "node scripts/backfill-smtp-password-encryption.js",
    "backfill:primary-remittance": "npx ts-node prisma/backfill-primary-remittance.ts",
    "test:unit": "vitest run tests/sidebar/sidebar-rules.unit.test.ts",
    "test:integration": "vitest run tests/sidebar/mobile-drawer-parity.integration.test.ts",
    "test:smoke": "playwright test tests/smoke",
    "test:browser:install": "npx playwright install --with-deps chromium",
    "test:browser:smoke": "playwright test tests/smoke --project=chromium",
    "test:browser:headed": "playwright test tests/smoke --project=chromium --headed",
    "test:browser:ui": "playwright test tests/smoke --project=chromium --ui",
    "test:payments": "vitest run tests/payments && playwright test tests/payments",
    "test": "vitest run"
  },
