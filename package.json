    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@types/dompurify": "^3.2.0",
    "@types/jszip": "^3.4.1",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "5.77.4",
    "clamscan": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.0",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^1.6.0",
    "html5-qrcode": "^2.3.8",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.5.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "plaid": "^42.1.0",
    "qrcode": "1.5.4",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "razorpay": "^2.9.8",
    "react": "19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.10.1",
    "regenerator-runtime": "0.14.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.7",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^21.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/clamscan": "^2.4.1",
    "@types/exceljs": "^1.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "26.6.6",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pngjs": "^7.0.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "axios": "^1.21.1",
    "follow-redirects": "^1.16.3",
    "picomatch": "^4.0.4",
    "path-to-regexp": "^8.4.2",
    "defu": "^6.1.7",
    "effect": "^3.21.1",
    "hono": "^4.12.18",
    "@hono/node-server": "^1.19.14",
    "brace-expansion@^1": "1.1.22",
    "brace-expansion@^4": "^5.0.13",
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "postcss": "^8.5.33",
    "uuid": "^14.0.0",
    "brace-expansion@^2": "2.1.8",
    "@humanfs/node": "^0.16.8",
    "nanoid": "^3.3.20",
    "source-map-js": "^1.2.2",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    },
    "@serwist/build": {
      "zod": "4.6.7"
    },
    "@serwist/next": {
      "zod": "4.6.7"
    },
    "@serwist/webpack-plugin": {
      "zod": "4.6.7"
    }
  },
  "packageManager": "npm@11.20.0"
}
