  domain   MailBillingDomain? @relation(fields: [domainId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   MailBillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  serverId String?
