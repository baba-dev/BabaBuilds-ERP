  @@index([workspaceId, scopeType, scopeKey, priority])
}

model TaxDecisionAuditLog {
  id                  String              @id @default(cuid())
  workspaceId         String
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId           String?
