/// LIST = margin % × catalog list price; PAID = margin % × amount customer paid
enum DistributorMarginBasis {
  LIST
  PAID
}

enum DistributorPayoutStatus {
  DRAFT
  PAID
}

// ==========================================
// DISTRIBUTOR / CHANNEL PARTNERS (subscription coupons & margins)
// ==========================================

model Distributor {
  id     String @id @default(cuid())
  name   String
  email  String @unique
  status String @default("ACTIVE") // ACTIVE | INACTIVE

  /// Default partner margin % of list price (catalog). Per-coupon can override.
  defaultMarginPercent Decimal @default(0)

  /// Default: commission = margin% × list; PAID = margin% × net paid
  defaultMarginBasis DistributorMarginBasis @default(LIST)

  /// Optional JSON map of interval -> margin percent, e.g. {"MONTHLY":12,"YEARLY":10}
  marginByPlanJson Json?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupons      DistributorCoupon[]
  attributions DistributorAttribution[]
  commissions  DistributorCommission[]
  payouts      DistributorPayout[]
  auditLogs    DistributorAuditLog[]
  partnerUsers User[]
}

model DistributorCoupon {
  id String @id @default(cuid())

  distributorId String
  distributor     Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  /// Uppercase normalized code (e.g. PARTNER-ABC123)
  code String @unique

  /// Customer-facing discount % off list subscription price at checkout
  customerDiscountPercent Decimal @default(0)

  /// Partner margin % of list price for commission reporting (independent of discount)
  marginPercent Decimal @default(0)

  /// Overrides distributor default when set
  marginBasis DistributorMarginBasis?

  /// Comma-separated: PRO, TEAM or ALL
  allowedTiers String @default("PRO,TEAM")

  firstPurchaseOnly Boolean @default(false)

  startsAt DateTime?
  endsAt   DateTime?

  isActive Boolean @default(true)
  maxUses  Int?
  usedCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributions DistributorAttribution[]
  commissions  DistributorCommission[]
  billingTransactions BillingTransaction[]

  @@index([distributorId, isActive])
}

model DistributorPayout {
  id String @id @default(cuid())

  distributorId String
  distributor     Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  status      DistributorPayoutStatus @default(DRAFT)
  periodLabel String?
  totalAmount Decimal               @default(0)
  method      String?
  reference   String?
  paidAt      DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions DistributorCommission[]

  @@index([distributorId, status, createdAt])
}

model DistributorAuditLog {
  id String @id @default(cuid())

  distributorId String?
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  actorEmail String?
  action     String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([distributorId, createdAt])
  @@index([createdAt])
}

/// One workspace is attributed to at most one distributor (latest applied coupon wins).
model DistributorAttribution {
  id String @id @default(cuid())

  couponId String
  coupon     DistributorCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  distributorId String
  distributor     Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  appliedAt DateTime @default(now())

  @@index([distributorId, appliedAt])
}

/// One commission row per successful subscription payment (billing transaction).
model DistributorCommission {
  id String @id @default(cuid())

  distributorId String
  distributor     Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  couponId String?
  coupon     DistributorCoupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  billingTransactionId String @unique
  billingTransaction   BillingTransaction @relation(fields: [billingTransactionId], references: [id], onDelete: Cascade)

  /// Catalog list amount (INR) before distributor coupon discount
  listAmount Decimal @default(0)
  /// Amount the customer actually paid (INR)
  paidAmount Decimal @default(0)
  /// Snapshot of margin % used for this sale
  marginPercent Decimal @default(0)
  /// Commission = listAmount * marginPercent / 100
  commissionAmount Decimal @default(0)

  status DistributorCommissionStatus @default(PENDING)

  /// Snapshot: LIST or PAID basis used for this row
  marginBasisUsed DistributorMarginBasis @default(LIST)

  payoutId String?
  payout   DistributorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  clawbackReason String?
  reversedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([distributorId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([status, distributorId])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ReferralRewardType {
  FREE_MONTH
  WALLET_CREDIT
}

enum ReportShareScope {
  WORKSPACE
  GROUP
}

enum ReportShareAudience {
  INTERNAL
  EXTERNAL
}

enum ReportShareStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ReferralRewardStatus {
  PENDING
  APPROVED
  APPLIED
  CANCELLED
}

// ==========================================
// 1. AUTHENTICATION (NextAuth Standard)
// ==========================================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String? // This acts as the Avatar URL
  role          String    @default("USER") // "USER", "ADMIN"

  // --- PASSWORD AUTHENTICATION ---
  passwordHash             String?
  passwordUpdatedAt        DateTime?
  passwordFailedAttempts   Int       @default(0)
  passwordLockedUntil      DateTime?
  passwordLastFailureAt    DateTime?

  // --- DEMO LIFECYCLE ---
  isDemo          Boolean   @default(false)
  demoTemplateKey String?
  demoExpiresAt   DateTime?

  // --- NEW: PERSONAL PREFERENCES ---
  theme              String @default("system") // "light", "dark", "system"
  dateFormat         String @default("DD/MM/YYYY")
  timeZone           String @default("Asia/Kolkata")
  locale             String @default("en-IN") // Formatting rules (e.g., en-IN, en-US)
  currencyFormat     String @default("INR") // Currency symbol/math (e.g., INR, USD)
  defaultLandingPage String @default("/dashboard") // e.g., "/dashboard", "/invoice", "/clients"

  // --- NOTIFICATION SETTINGS ---
  transactionalAlerts Boolean @default(true) // E.g., "Invoice Paid" alerts
  marketingEmails     Boolean @default(false) // Product updates/news
  weeklyReport        Boolean @default(true) // AI Financial Summary emails
  // Granular channel toggles (user-configurable per channel)
  notifyEmail         Boolean @default(true)
  notifyPush          Boolean @default(true)
  notifyInApp         Boolean @default(true)

  // --- RELATIONS ---
  accounts           Account[]
  sessions           Session[]
  workspaces         WorkspaceUser[]
  appActivities      AppActivityLog[]    @relation("AppActivityActor")
  pushSubscriptions  PushSubscription[]
  inAppNotifications InAppNotification[]
  onboarding         UserOnboarding?
  userPreference     UserPreference?
  passwordResetTokens PasswordResetToken[]
  webAuthnCredentials WebAuthnCredential[]
  webAuthnChallenges WebAuthnChallenge[]
  companyGroupMemberships CompanyGroupMember[]
  createdReportShares     ReportShare[] @relation("ReportShareCreator")

  /// When set, this user can access the distributor partner portal for this partner record
  distributorPartnerId String?
  distributorPartner   Distributor? @relation(fields: [distributorPartnerId], references: [id], onDelete: SetNull)

  referralProfile    CustomerReferralProfile?

  @@index([distributorPartnerId])
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String   @unique
  publicKey    String
  counter      Int      @default(0)
  transports   String?
  deviceType   String?
  backedUp     Boolean  @default(false)
  name         String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  challenge String   @unique
  tokenHash String?  @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([userId, type])
  @@index([expiresAt])
}

model UserOnboarding {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona        String?
  isFirstLogin   Boolean   @default(true)
  completedSteps String    @default("[]")
  dismissedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isFirstLogin])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  requestedIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// 2. MULTI-TENANCY & BILLING (The "Workspace")
// ==========================================
model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // --- DEMO LIFECYCLE ---
  isDemo          Boolean   @default(false)
  demoTemplateKey String?
  demoExpiresAt   DateTime?

  // --- NEW: GLOBALIZATION STATE ---
  isSetupComplete Boolean @default(false) // Triggers the Popup Wizard
  countryCode     String  @default("IN") // ISO 2-letter code (US, AE, GB, IN)
  baseCurrency    String  @default("INR") // Functional currency for reports

  // --- EXISTING BILLING ---
  subscriptionStatus   String    @default("FREE") // "TRIALING", "PRO", "FREE", "SUSPENDED"
  subscriptionEndsAt   DateTime?
  planTier             String    @default("FREE") // "FREE", "PRO", "TEAM"
  currentMonthInvoices Int       @default(0)
  seatAddonCount       Int       @default(0) // future: purchased additional seats

  planInterval      String? // "MONTHLY", "QUARTERLY", "YEARLY"
  paymentMethodMask String? // e.g., "•••• 4242" or "user@upi"
  billingProviderId String? // Stripe/Razorpay Customer ID

  // Canonical provider contract identity and cancellation reconciliation state.
  // PREPAID orders expire locally; RECURRING contracts must be cancelled at the provider first.
  billingProvider               String? // "RAZORPAY" | "STRIPE" | "GOOGLE_PLAY"
  billingContractType           String   @default("PREPAID") // "PREPAID" | "RECURRING"
  billingProviderSubscriptionId String?
  subscriptionCancelAtPeriodEnd Boolean  @default(false)
  subscriptionCancelRequestedAt DateTime?
  subscriptionCancelEffectiveAt DateTime?
  subscriptionCancellationLastError String?

  /// True after at least one successful paid subscription charge (for partner first-purchase coupons)
  hasEverSubscribed Boolean @default(false)
  signupIntentJson  String?

  updatedAt DateTime @default(now()) @updatedAt

  // RELATIONS
  users                           WorkspaceUser[]
  companyGroupLinks               CompanyGroupWorkspace[]
  billingForGroups                CompanyGroup[] @relation("CompanyGroupBillingWorkspace")
  companyGroupMemberAccesses      CompanyGroupMemberWorkspaceAccess[]
  businessProfile                 BusinessProfile?
  clients                         Client[]
  invoices                        Invoice[]
  billingTransactions             BillingTransaction[]
  playPurchases                   PlayPurchase[]
  resellerLeads                  ResellerLead[]
  customerReferralProfiles       CustomerReferralProfile[]
  referralRedemptions            CustomerReferralRedemption[]
  referralRewards                CustomerReferralReward[]       @relation("ReferrerWorkspace")
  expenses                        Expense[]
  withholdingEvents               WithholdingEvent[]
  taxCreditEvents                 TaxCreditEvent[]
  taxCreditLedgerEntries          TaxCreditLedgerEntry[]
  taxReturnPeriods                TaxReturnPeriod[]
  bankTransactions                BankTransaction[]
  bankAccounts                    BankAccount[]
  bankImportBatches               BankImportBatch[]
  workspaceReconciliationSettings WorkspaceReconciliationSettings?
  expenseReconciliationCategories ExpenseReconciliationCategory[]
  bankReconciliationRules         BankReconciliationRule[]
  investments                     Investment[]
  serviceTemplates                ServiceTemplate[]
  proposals                       Proposal[]
  proposalConversions             ProposalConversion[]
  billingMilestones               BillingMilestone[]
  retainers                       Retainer[]
  tasks                           Task[]
  invoiceIdempotencies            InvoiceIdempotency[]
  invoiceGenerationDrafts         InvoiceGenerationDraft[]
  financialOperationLocks         FinancialOperationIdempotency[]
  taxPreference                   WorkspaceTaxPreference?
  workspaceTaxOverrides           WorkspaceTaxOverride[]
  taxRateOverrides                TaxRateOverride[]
  taxRateOverrideAuditLogs        TaxRateOverrideAuditLog[]
  taxDecisionAuditLogs            TaxDecisionAuditLog[]
  taxableEvents                   TaxableEvent[]
  taxDeterminations               TaxDetermination[]
  taxComponentLines               TaxComponentLine[]
  taxAuditEvents                  TaxAuditEvent[]
  taxOperationIdempotencies       TaxOperationIdempotency[]
  taxReferenceEntries             TaxReferenceEntry[]
  taxPeriods                      TaxPeriod[]
  taxForms                        TaxForm[]
  taxReturns                      TaxReturn[]
  taxReturnFieldValues            TaxReturnFieldValue[]
  taxReadinessChecks              TaxReadinessCheck[]
  taxReadinessBlockers            TaxReadinessBlocker[]
  fileImportAuditLogs             FileImportAuditLog[]
  appActivityLogs                 AppActivityLog[]
  workspaceInvites                WorkspaceInvite[]
  distributorAttribution         DistributorAttribution?
  distributorCommissions         DistributorCommission[]
  accountingTransactions          AccountingTransaction[]
  accountingIntegrityRuns         AccountingIntegrityRun[]
  accountingViolationReports      AccountingViolationReport[]
  cashForecastSnapshots           CashForecastSnapshot[]
  cashForecastAssumptions         CashForecastAssumption[]
  cashForecastAdjustments         CashForecastManualAdjustment[]
  cashForecastLineItemPlans       CashForecastLineItemPlan[]
  cashForecastAlertPreferences    CashForecastAlertPreference[]
  clientPaymentBehaviors          ClientPaymentBehavior[]
  rbacAuditLogs                   RbacAuditLog[]
  mailBillingServers              MailBillingServer[]
  mailBillingDomains              MailBillingDomain[]
  mailBillingMailboxes            MailBillingMailbox[]
  mailBillingSyncRuns             MailBillingSyncRun[]
  mailBillingPlans                MailBillingPlan[]
  mailBillingSubscriptions        MailBillingSubscription[]
  mailBillingReviewItems          MailBillingReviewItem[]
  mailBillingSettings             MailBillingSettings?

  // IMS Relations
  products           Product[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  accountingEntries  AccountingEntry[]
  shopOrders         ShopOrder[]

  // Workforce Module
  workspaceModules  WorkspaceModule[]
  importRuns        ImportRun[]
  employees         Employee[]
  departments       Department[]
  designations      Designation[]
  attendanceRecords AttendanceRecord[]
  leaveTypes        LeaveType[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  workforceHolidays WorkforceHoliday[]
  workSchedules     WorkSchedule[]
  payrollSettings   PayrollSettings?
  payComponents     PayrollPayComponent[]
  payrollPeriods    PayrollPeriod[]
  payrollRuns       PayrollRun[]
  payrollPostings   PayrollPosting[]

  // Document Vault (optional module)
  documents               Document[]
  documentFiles           DocumentFile[]
  documentOcrJobs         DocumentOcrJob[]
  documentExtractedFields DocumentExtractedField[]
  documentLinks           DocumentLink[]
  taxDocumentLinks        TaxDocumentLink[]
  taxImportBatches        TaxImportBatch[]
  taxImportRows           TaxImportRow[]
  documentAuditEvents     DocumentAuditEvent[]
  documentStorage         WorkspaceDocumentStorage?
  taxRegistrations        WorkspaceTaxRegistration[]
  filingCalendarRules     FilingCalendarRule[]
  taxObligations          TaxObligation[]
  taxObligationPeriods    TaxObligationPeriod[]
  gstReturns              GstReturn[]
  caComplianceItems       CaComplianceItem[]
  caRequests              CaRequest[]
  gstAdjustments          GstAdjustment[]
  gstDebitNotes           GstDebitNote[]
  gstAmendments           GstAmendment[]
  gstAdvances             GstAdvance[]
  gstReturnComments       GstReturnComment[]
  gstReminderLogs         GstReminderLog[]
  gstr2bEntries           Gstr2bEntry[]
  complianceTasks         ComplianceTask[]
  reportShares            ReportShare[]
  reportShareSnapshots    ReportShareSnapshot[]

  @@index([isDemo])
  @@index([demoExpiresAt])
  @@index([demoTemplateKey])
}

model CompanyGroup {
  id   String @id @default(cuid())
  name String

  // --- GROUP BILLING ---
  subscriptionStatus String    @default("FREE") // "TRIALING", "PRO", "FREE", "SUSPENDED"
  subscriptionEndsAt DateTime?
  planTier           String    @default("FREE") // "FREE", "PRO", "TEAM"

  /// Optional workspace that owns billing for the company group.
  billingWorkspaceId String?
  billingWorkspace   Workspace? @relation("CompanyGroupBillingWorkspace", fields: [billingWorkspaceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces CompanyGroupWorkspace[]
  members    CompanyGroupMember[]
  modules    CompanyGroupModule[]
  reportShares ReportShare[]
  reportShareSnapshots ReportShareSnapshot[]

  @@index([billingWorkspaceId])
}

model CompanyGroupWorkspace {
  id String @id @default(cuid())

  companyGroupId String
  companyGroup   CompanyGroup @relation(fields: [companyGroupId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  relationType String  @default("MEMBER")
  isPrimary    Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyGroupId, workspaceId])
  @@index([workspaceId, isActive])
  @@index([companyGroupId, isPrimary])
}

model CompanyGroupMember {
  id String @id @default(cuid())

  companyGroupId String
  companyGroup   CompanyGroup @relation(fields: [companyGroupId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role       String  @default("MEMBER")
  groupRole  String  @default("MEMBER")
  accessMode String  @default("SPECIFIC_COMPANIES")
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceAccess CompanyGroupMemberWorkspaceAccess[]

  @@unique([companyGroupId, userId])
  @@index([userId])
  @@index([companyGroupId, isActive])
}

model CompanyGroupMemberWorkspaceAccess {
  id String @id @default(cuid())

  companyGroupMemberId String
  companyGroupMember   CompanyGroupMember @relation(fields: [companyGroupMemberId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  accessRole String  @default("MEMBER")
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyGroupMemberId, workspaceId])
  @@index([workspaceId, isActive])
}

model CompanyGroupModule {
  id String @id @default(cuid())

  companyGroupId String
  companyGroup   CompanyGroup @relation(fields: [companyGroupId], references: [id], onDelete: Cascade)

  moduleKey String
  isEnabled Boolean @default(true)
  configJson Json?

  enabledAt  DateTime  @default(now())
  disabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyGroupId, moduleKey])
  @@index([companyGroupId, isEnabled])
}

model ResellerAccount {
  id String @id @default(cuid())

  name  String
  email String @unique

  status                   ResellerStatus @default(ACTIVE)
  defaultCustomerDiscount  Decimal        @default(25)
  defaultCommissionPercent Decimal        @default(12.5)
  payoutTerms              String         @default("Net 30")
  notes                    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupons     ResellerCoupon[]
  leads       ResellerLead[]
  commissions ResellerCommission[]
  payouts     ResellerPayout[]
}

model ResellerCoupon {
  id String @id @default(cuid())

  resellerId String
  reseller   ResellerAccount @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  code             String             @unique
  audience         CouponAudience     @default(RESELLER)
  discountType     CouponDiscountType @default(PERCENT)
  discountValue    Decimal            @default(25)
  commissionPercent Decimal           @default(12.5)
  firstPurchaseOnly Boolean           @default(true)
  firstYearOnly     Boolean           @default(true)
  isActive          Boolean           @default(true)
  maxUses           Int?
  usedCount         Int               @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads ResellerLead[]

  @@index([resellerId, isActive])
}

model ResellerLead {
  id String @id @default(cuid())

  resellerId String
  reseller   ResellerAccount @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  couponId String?
  coupon   ResellerCoupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  workspaceId String @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  stage         LeadStage @default(LEAD)
  conversionAt  DateTime?
  closedDealValue Decimal?
  notes         String?
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions ResellerCommission[]

  @@index([resellerId, stage, createdAt])
}

model ResellerPublicQuery {
  id String @id @default(cuid())

  fullName String
  email    String
  company  String?
  phone    String?
  website  String?

  monthlyClientLeads Int?
  message            String
  budgetBand         String?
  status             LeadStage @default(LEAD)
  source             String    @default("public_reseller_page")
  metadata           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model ResellerCommission {
  id String @id @default(cuid())

  resellerId String
  reseller   ResellerAccount @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  leadId String?
  lead   ResellerLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  billingTransactionId String?
  billingTransaction   BillingTransaction? @relation(fields: [billingTransactionId], references: [id], onDelete: SetNull)

  dealAmount         Decimal @default(0)
  commissionPercent  Decimal @default(0)
  commissionAmount   Decimal @default(0)
  status             CommissionStatus @default(PENDING)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payoutId String?
  payout   ResellerPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([resellerId, status, createdAt])
}

model ResellerPayout {
  id String @id @default(cuid())

  resellerId String
  reseller   ResellerAccount @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  payoutDate DateTime?
  method     String?
  reference  String?
  totalAmount Decimal @default(0)
  status      PayoutStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions ResellerCommission[]

  @@index([resellerId, status, createdAt])
}

model CustomerReferralProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  code           String  @unique
  isActive       Boolean @default(true)
  shareLink      String?
  totalReferrals Int     @default(0)
  successfulReferrals Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CustomerReferralRedemption[]

  @@index([workspaceId, isActive])
}

model CustomerReferralRedemption {
  id String @id @default(cuid())

  profileId String
  profile   CustomerReferralProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  referredWorkspaceId String @unique
  referredWorkspace   Workspace @relation(fields: [referredWorkspaceId], references: [id], onDelete: Cascade)

  friendDiscountPercent Decimal @default(20)
  convertedAt           DateTime?
  metadata              Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewards CustomerReferralReward[]

  @@index([profileId, createdAt])
}

model CustomerReferralReward {
  id String @id @default(cuid())

  redemptionId String
  redemption   CustomerReferralRedemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)

  referrerWorkspaceId String
  referrerWorkspace   Workspace @relation("ReferrerWorkspace", fields: [referrerWorkspaceId], references: [id], onDelete: Cascade)

  rewardType ReferralRewardType   @default(WALLET_CREDIT)
  rewardStatus ReferralRewardStatus @default(PENDING)
  walletCreditAmount Decimal?
  freeMonthsCount     Int?
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerWorkspaceId, rewardStatus, createdAt])
}

model DemoProvisionAttempt {
  id String @id @default(cuid())

  createdAt DateTime @default(now())

  ip          String?
  fingerprint String?
  templateKey String?

  isAllowed         Boolean @default(false)
  blockReason       String?
  retryAfterSeconds Int?

  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([fingerprint, createdAt])
  @@index([templateKey, createdAt])
}

model AppActivityLog {
  id String @id @default(cuid())

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  actorUserId String?
  actorUser   User?   @relation("AppActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String?

  action     String
  entityType String?
  entityId   String?

  status   String // "SUCCESS" | "FAILURE" | "WARNING" | "INFO"
  metadata Json?

  ipAddress     String?
  userAgent     String?
  correlationId String?

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}

/// A Google Play subscription purchase token, bound to exactly one workspace.
/// Created only by the authenticated verify endpoint; Real-time developer notifications (RTDN)
/// carry just the token, so this table is how a notification finds its workspace.
model PlayPurchase {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  purchaseToken       String    @unique
  /// Play subscription product id (== our SKU, see lib/billing/play-products.ts)
  productId           String
  /// SubscriptionIntervalKey the SKU maps to (MONTHLY, YEARLY, TEAM_MONTHLY, ...)
  interval            String
  /// Raw Google SubscriptionPurchaseV2.subscriptionState (e.g. SUBSCRIPTION_STATE_ACTIVE)
  subscriptionState   String
  autoRenewing        Boolean   @default(false)
  expiresAt           DateTime?
  latestOrderId       String?
  /// Set when this purchase replaces an earlier token (resubscribe / plan change)
  linkedPurchaseToken String?
  isTestPurchase      Boolean   @default(false)
  acknowledgedAt      DateTime?
  lastSyncedAt        DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model BillingTransaction {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  transactionDate   DateTime @default(now())
  amount            Decimal  @default(0)
  status            String   @default("PAID") // "PAID", "PENDING", "FAILED", etc.
  description       String
  providerReference String?
  receiptUrl        String?

  /// Catalog subscription list price (INR) for this charge before distributor coupon discount.
  subscriptionListAmount Decimal?
  distributorCouponId     String?
  distributorCoupon       DistributorCoupon? @relation(fields: [distributorCouponId], references: [id], onDelete: SetNull)

  distributorCommission DistributorCommission?

  /// ISO 4217 for subscription charges (checkout currency)
  subscriptionCurrency String? @default("INR")
  /// e.g. MONTHLY, YEARLY — snapshot at payment time
  subscriptionInterval String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resellerCommissions ResellerCommission[]

  @@unique([workspaceId, providerReference])
  @@index([workspaceId, transactionDate])
  @@index([distributorCouponId])
}

model FinancialOperationIdempotency {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operation      String
  idempotencyKey String
  requestHash    String
  responseBody   Json?
  status         String    @default("PENDING") // "PENDING" | "CONSUMED"
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, operation, idempotencyKey])
  @@index([workspaceId, operation, expiresAt])
}

model ProcessedWebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventId   String
  eventType String
  status    String   @default("RECEIVED") // "RECEIVED" | "PROCESSED" | "FAILED"
  payload   Json?
  errorMessage String?
  processedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, eventId])
  @@index([provider, createdAt])
  @@index([provider, status, createdAt])
}

model AccountingTransaction {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  eventType       AccountingEventType
  eventOccurredAt DateTime
  postedAt        DateTime            @default(now())
  postingCurrency String
  exchangeRate    Decimal?
  description     String?

  sourceTable      String
  sourceId         String
  sourceRef        String?
  requestId        String?
  jobId            String?
  statementBatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries AccountingEntry[]

  @@unique([workspaceId, sourceTable, sourceId, eventType])
  @@index([workspaceId, eventType, postedAt])
  @@index([workspaceId, sourceTable, sourceId])
  @@index([requestId])
  @@index([jobId])
}

model AccountingEntry {
  id String @id @default(cuid())

  transactionId String
  transaction   AccountingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  lineNumber  Int
  accountCode String
  side        AccountingLineSide
  amount      Decimal
  currency    String
  postedAt    DateTime
  isPosted    Boolean            @default(true)

  createdAt DateTime @default(now())

  @@unique([transactionId, lineNumber])
  @@index([workspaceId, accountCode, postedAt])
  @@index([workspaceId, transactionId])
}

model AccountingIntegrityRun {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  runType     String    @default("NIGHTLY")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("RUNNING")
  summary     Json?

  violations AccountingViolationReport[]

  @@index([workspaceId, startedAt(sort: Desc)])
}

model AccountingViolationReport {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  runId String
  run   AccountingIntegrityRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  invariantCode String
  severity      String   @default("ERROR")
  details       Json
  detectedAt    DateTime @default(now())

  @@index([workspaceId, detectedAt(sort: Desc)])
  @@index([runId, invariantCode])
}

model WorkspaceUser {
  id          String @id @default(cuid())
  userId      String
  workspaceId String

  /// Legacy role field — kept for JWT/session compatibility.
  /// Server-side enforcement uses `businessRole` via fresh DB lookup in lib/rbac.ts.
  role String @default("OWNER") // "OWNER", "MEMBER"

  /// ERP business role — Prisma-enum-validated, authoritative for permissions.
  /// Null means the role has not been migrated yet; lib/rbac.ts falls back to `role`.
  businessRole BusinessRoleEnum? @default(OWNER)

  /// Whether this member currently has active workspace access.
  /// Deactivated members retain their record for audit trail but cannot access the workspace.
  /// Deactivated members do NOT count toward the seat limit.
  isActive Boolean @default(true)

  /// When this member joined (accepted invite or was auto-provisioned).
  joinedAt DateTime @default(now())

  /// Last time this member was seen active (updated by auth callbacks).
  lastActiveAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, isActive])
  @@index([workspaceId, businessRole])
}

/// Shareable report link for either a single workspace or a company group.
/// External GROUP shares must use snapshots by default so future companies added to the group are not exposed through old links.
model ReportShare {
  id String @id @default(cuid())

  scope    ReportShareScope
  audience ReportShareAudience @default(INTERNAL)
  status   ReportShareStatus   @default(ACTIVE)

  /// Stable report identifier such as "profit-loss", "cash-flow", or "group-consolidated".
  reportKey String
  name      String?

  /// Secret-bearing public token; keep unique and rotate by creating a new share.
  token     String  @unique
  tokenHash String? @unique

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  companyGroupId String?
  companyGroup   CompanyGroup? @relation(fields: [companyGroupId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdBy       User?   @relation("ReportShareCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// Defaults to false so external group shares are snapshots unless explicitly promoted to a live internal workflow.
  liveDataEnabled Boolean @default(false)

  expiresAt    DateTime?
  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots ReportShareSnapshot[]

  @@index([scope, audience, status])
  @@index([workspaceId, status])
  @@index([companyGroupId, status])
  @@index([createdByUserId])
  @@index([expiresAt])
}

/// Point-in-time data contract for external group report shares.
/// Stores the exact companies, query shape, permissions, and generated artifact from creation time.
model ReportShareSnapshot {
  id String @id @default(cuid())

  reportShareId String
  reportShare   ReportShare @relation(fields: [reportShareId], references: [id], onDelete: Cascade)

  /// Denormalized owning workspace when the snapshot is generated from a workspace-scoped share.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  /// Denormalized owning group when the snapshot is generated from a group-scoped share.
  companyGroupId String?
  companyGroup   CompanyGroup? @relation(fields: [companyGroupId], references: [id], onDelete: SetNull)

  /// Workspace IDs included when the snapshot was created; do not recompute for external group links.
  includedWorkspaceIds Json

  filtersJson Json?
  columnsJson Json?

  dateRangeStart DateTime?
  dateRangeEnd   DateTime?

  allowPii              Boolean @default(false)
  allowDownload         Boolean @default(false)
  allowCompanyBreakdown Boolean @default(false)

  /// Inline generated report payload for small reports.
  generatedPayloadJson Json?

  /// File/object-storage path for large generated exports.
  exportPath String?

  snapshotVersion Int      @default(1)
  createdAt       DateTime @default(now())

  @@index([reportShareId, createdAt])
  @@index([workspaceId])
  @@index([companyGroupId])
}

model WorkspaceInvite {
  id          String @id @default(cuid())
  workspaceId String
  email       String

  /// The ERP business role this invite will grant upon acceptance.
  role         String           @default("STAFF") // legacy — kept for email template compatibility
  businessRole BusinessRoleEnum @default(STAFF)

  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId, expiresAt])
}

// ==========================================
// 3. SECURED BUSINESS DATA
// ==========================================

model BusinessProfile {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  companyName    String
  proprietorName String
  address        String
  email          String
  phone          String?
  website        String?

  invoiceTheme  String  @default("DESIGN_1") // "DESIGN_1" or "DESIGN_2"
  invoicePrefix String? @default("INV")
  invoiceTermsDays Int @default(7) // default payment terms: due date = invoice date + this many days

  // --- DYNAMIC TAX LABELS ---
  // In the UI, instead of "Enter GST", we show "Enter {taxLabel}"
  taxLabel     String @default("GST") // "VAT", "Sales Tax", "GST"
  taxIdLabel   String @default("GSTIN") // "TRN", "EIN", "GSTIN"
  routingLabel String @default("IFSC Code") // "SWIFT", "Sort Code", "ABA"

  // Compliance (Keeping legacy names for no-break compatibility)
  panNumber   String // Acts as Primary Tax ID
  udyamNumber String? // Acts as Secondary Business ID
  gstin       String? // Acts as the Regional Tax ID
  // GST (India): supplier state (2-digit GST state code), registration scheme and filing cadence.
  gstStateCode          String? // "27" = Maharashtra
  gstRegistrationType   String   @default("REGULAR") // REGULAR | COMPOSITION | UNREGISTERED
  gstFilingFrequency    String   @default("MONTHLY") // MONTHLY | QRMP (quarterly GSTR-1/3B)
  gstPrevFyTurnover     Decimal? // aggregate turnover of the previous FY (drives HSN digits, late-fee caps)
  gstRegisteredFrom     DateTime?
  gstRemindersEnabled   Boolean  @default(true) // due-date alerts and the weekly digest
  // CA compliance: what kind of taxpayer this is, which drives the compliance calendar.
  caEntityType          String? // PROPRIETOR | PARTNERSHIP | LLP | COMPANY | OTHER
  caTaxRegime           String? // NEW | OLD (individuals and proprietors)
  caPresumptive         String? // NONE | SEC_44ADA | SEC_44AD
  caTaxAuditApplicable  Boolean  @default(false)
  caTan                 String? // TAN of the deductor, needed for TDS returns
  caSetupAt             DateTime?
  gstSupplyKind         String   @default("SERVICES") // SERVICES | GOODS | BOTH: picks the GST registration threshold
  msmeInvestment        Decimal? // plant, machinery and equipment, for MSME classification
  gstLutActive          Boolean  @default(true) // exports of services under a Letter of Undertaking (zero-rated, no IGST)

  // Banking
  bankName      String
  accountName   String
  accountNumber String
  ifscCode      String // General routing code
  primaryBankAccountId String?
  primaryBankAccount   BankAccount? @relation("PrimaryRemittanceBankAccount", fields: [primaryBankAccountId], references: [id], onDelete: SetNull)

  logoUrl        String?
  signatureUrl   String?
  groqApiKey     String?
  defaultSacCode String? @default("998313") // Default IT Consulting if not specified
  defaultTaxRate Float?

  // PAYMENT GATEWAY (Per-Tenant Razorpay Keys — PRO users only)
  razorpayKeyId     String? // Plain text (publishable key, e.g. rzp_live_xxx)
  razorpayKeySecret String? // AES-256-GCM encrypted blob (NEVER stored plain)

  // PAYMENT GATEWAY — Stripe (PRO users only, global)
  stripePublishableKey String? // Plain text (pk_live_xxx)
  stripeSecretKey      String? // AES-256-GCM encrypted blob (NEVER stored plain)
  defaultGateway       String? @default("RAZORPAY") // "RAZORPAY" | "STRIPE"

  // PUBLIC SHOP (E-Store)
  shopSlug        String? @unique // URL slug e.g. "bababuilds" → /shop/bababuilds
  shopTagline     String? // Hero subtitle shown on shop page
  shopEnabled     Boolean @default(false) // Master on/off for the public shop
  shopAccentColor String? @default("#6366f1") // HSL accent color for shop branding

  // PUBLIC SHOP — content blocks (admin-editable, rendered on /shop/<slug>)
  shopAnnouncement String? // Optional thin banner shown above the hero (e.g. promo / shipping notice)
  shopAboutMd      String? // Markdown body for the "About Us" section (sanitized at render time)
  shopFooterNote   String? // Optional fine-print / shop-specific footer note (plain text)
  shopSocialJson   String? // JSON: array of { platform, url } pairs (instagram, facebook, x, linkedin, youtube, whatsapp, custom)
  shopFaqJson      String? // JSON: array of { q, a } FAQ entries (capped server-side)
  shopShowAiAssist Boolean @default(true) // Show in-shop "AI Assist" lead-capture drawer for buyers

  // EMAIL SERVER (SMTP)
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPassword  String?
  smtpFromEmail String?

  updatedAt DateTime @updatedAt

  @@index([primaryBankAccountId])
}

model Client {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name    String
  address String
  country String
  taxId   String?
  // GST: recipient state (2-digit GST state code). Needed for place of supply (CGST+SGST vs IGST).
  gstStateCode String?
  // GST: standing treatment copied onto every new invoice for this client (SEZ_WP | SEZ_WOP, or reverse charge).
  gstSupplyOverride String?
  gstReverseCharge  Boolean @default(false)
  email   String?
  phone   String?
  logoUrl String?

  status String @default("ACTIVE") // "ACTIVE", "INACTIVE", "VIP"

  // "isExport" becomes "isTaxExempt" in global context
  isExport Boolean @default(true)

  // --- CRM ---
  countryCode      String? // ISO 3166-1 alpha-2, normalised from `country` (decides domestic vs export)
  website          String?
  industry         String?
  currency         String? // preferred invoice currency (ISO 4217); the composer starts with it
  paymentTermsDays Int? // overrides the workspace default payment terms for this client
  creditLimit      Decimal? // in the workspace base currency; warns when outstanding plus a new invoice exceeds it
  tags             String   @default("") // "|vip|agency|": see lib/clients/tags
  source           String   @default("MANUAL") // MANUAL | IMPORT | AI | POS
  isWalkIn         Boolean  @default(false) // the POS counter customer: hidden from the CRM and not counted toward plan limits
  archivedAt       DateTime?
  ownerUserId      String? // who looks after this account
  lastContactedAt  DateTime?
  updatedAt        DateTime? @updatedAt
  contacts         ClientContact[]
  clientNotes      ClientNote[]
  expenses         Expense[]

  createdAt       DateTime               @default(now())
  invoices        Invoice[]
  proposals       Proposal[]
  retainers       Retainer[]
  paymentBehavior ClientPaymentBehavior?
  mailBillingDomains MailBillingDomain[]
  mailBillingSubscriptions MailBillingSubscription[]

  @@unique([name, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
}

model ClientPaymentBehavior {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  avgDaysToPay        Float?
  medianDaysToPay     Float?
  onTimeRate          Float?
  lateRate            Float?
  partialPaymentRate  Float?
  sampleInvoicesCount Int       @default(0)
  lastComputedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, lastComputedAt(sort: Desc)])
}

model Invoice {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  invoiceNumber       String
  financialYear       String
  billingMonth        String    @default("Unknown")
  invoiceDate         DateTime
  dueDate             DateTime?
  paymentTermsDays    Int?
  expectedPaymentDate DateTime?
  collectionRiskScore Float?
  lastReminderSentAt  DateTime?
  followUpStatus      String?
  clientName          String
  sacCode             String? // Removed the hardcoded @default("998313")
  serviceDescription  String

  subtotal    Decimal  @default(0)
  taxRate     Float    @default(0)
  taxAmount   Decimal  @default(0)
  grandTotal  Decimal  @default(0)
  taxMode     String   @default("exempt") // "taxable" | "exempt"
  totalAmount Decimal
  pdfPath     String
  createdAt   DateTime @default(now())

  status         InvoiceStatus @default(PENDING)
  amountReceived Decimal?
  dateReceived   DateTime?

  // Multi-currency: amounts above are in `currency`; `baseGrandTotal` is grandTotal * exchangeRate
  // in the workspace base currency (what reports and the /income KPIs add up).
  currency       String        @default("INR")
  exchangeRate   Decimal       @default(1)
  baseGrandTotal Decimal?
  source         InvoiceSource @default(MANUAL)
  sentAt         DateTime?
  voidedAt       DateTime?
  voidReason     String?
  // Set once stock for product lines has been deducted (at issue, or legacy: at payment). Guards double-deduction.
  stockCommittedAt DateTime?
  payments       InvoicePayment[]
  events         InvoiceEvent[]
  creditNotes    CreditNote[]

  withholdingRatePercent    Decimal?
  withholdingAmount         Decimal?
  withholdingDeductedAt     DateTime?
  withholdingDepositedAt    DateTime?
  withholdingDepositDueAt   DateTime?
  withholdingReminderSentAt DateTime?

  providerGateway       String? // "RAZORPAY" or "STRIPE"
  providerPaymentLinkId String? // The ID of the generated payment link

  clientId             String?
  client               Client?               @relation(fields: [clientId], references: [id])
  idempotencyRecords   InvoiceIdempotency[]
  taxDecisionAuditLogs TaxDecisionAuditLog[]
  taxableEvents        TaxableEvent[]
  items                InvoiceItem[]
  linkedShopOrders     ShopOrder[]           @relation("ShopOrderLinkedInvoice")
  generationDrafts     InvoiceGenerationDraft[] @relation("InvoiceGenerationDraftFinalizedInvoice")

  sourceProposalId      String?
  sourceProposal        Proposal?                     @relation("ProposalToInvoice", fields: [sourceProposalId], references: [id])
  proposalConversions   ProposalConversion[]
  billingMilestones     BillingMilestone[]
  withholdingEvents     WithholdingEvent[]
  bankTransactionSplits BankTransactionInvoiceSplit[]
  meteredUsages         MeteredUsage[]

  // The retainer cycle that produced this invoice (null for everything else).
  retainerId String?
  retainer   Retainer? @relation("RetainerInvoices", fields: [retainerId], references: [id], onDelete: SetNull)
  // Automatic reminders already sent for this invoice (retainer collections).
  reminderCount Int @default(0)

  // GST: optional explicit overrides; when null the return engine derives them from the client + business state.
  gstPlaceOfSupply String? // 2-digit state code, or "96" for exports
  gstReverseCharge Boolean @default(false)
  gstSupplyOverride String? // SEZ_WP | SEZ_WOP (supply to a SEZ unit/developer, with or without payment of tax)
  gstEcoGstin       String? // GSTIN of the e-commerce operator when the supply was made through one (GSTR-1 table 14)
  // e-invoicing: IRN and acknowledgement as returned by the Invoice Registration Portal.
  irn        String?
  irnAckNo   String?
  irnAckDate DateTime?
  ewayBillNo String?

  // Security: Two different workspaces can use invoice number "001"
  @@unique([invoiceNumber, workspaceId])
  @@index([financialYear])
  @@index([workspaceId])
  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, financialYear, status])
  @@index([workspaceId, clientId])
  @@index([workspaceId, invoiceDate])
  @@index([workspaceId, retainerId])
}

/// One received payment against an invoice. Invoice.amountReceived/status are derived from the
/// non-reversed rows. Reversal keeps the row (audit trail) instead of deleting it.
model InvoicePayment {
  id          String   @id @default(cuid())
  workspaceId String
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount      Decimal
  receivedAt  DateTime
  method      String   @default("OTHER") // BANK_TRANSFER | UPI | CARD | CASH | CHEQUE | PAYMENT_LINK | OTHER
  reference   String?
  notes       String?
  bankTransactionId String?

  idempotencyKey  String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  reversedAt       DateTime?
  reversedByUserId String?
  reversalReason   String?

  @@unique([workspaceId, idempotencyKey])
  @@index([invoiceId])
  @@index([workspaceId, receivedAt])
}

/// Append-only timeline for an invoice (created, sent, payment, reversal, void, reminder...).
model InvoiceEvent {
  id          String   @id @default(cuid())
  workspaceId String
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        String
  message     String?
  metadata    String?
  actorUserId String?
  createdAt   DateTime @default(now())

  @@index([invoiceId, createdAt])
}

/// Issued when an invoice is voided/cancelled or reduced (GST: cancellation is a credit note, not a delete).
model CreditNote {
  id               String   @id @default(cuid())
  workspaceId      String
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  creditNoteNumber String
  amount           Decimal
  taxAmount        Decimal  @default(0)
  reason           String
  issuedAt         DateTime @default(now())
  createdByUserId  String?

  @@unique([workspaceId, creditNoteNumber])
  @@index([invoiceId])
}

model WorkspaceTaxPreference {
  id                 String           @id @default(cuid())
  workspaceId        String           @unique
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mode               WorkspaceTaxMode @default(AUTO)
  defaultCountryCode String?
  provider           String?
  // Optional "tax estimate" card on /income (India professionals; presumptive-income rule).
  taxEstimateEnabled     Boolean @default(false)
  taxEstimateRatePercent Float   @default(50)
  updatedBy          String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model WorkspaceTaxOverride {
  id            String               @id @default(cuid())
  workspaceId   String
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scopeType     TaxOverrideScopeType
  scopeKey      String
  ratePercent   Float
  reason        String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  priority      Int                  @default(0)
  isActive      Boolean              @default(true)
  createdBy     String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([workspaceId, isActive, effectiveFrom, effectiveTo])
  @@index([workspaceId, scopeType, scopeKey, priority])
}

model TaxDecisionAuditLog {
  id                  String              @id @default(cuid())
  workspaceId         String
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId           String?
  invoice             Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  resolvedRatePercent Float
  resolutionSource    TaxResolutionSource
  basisJson           Json
  inputHash           String
  createdBy           String
  createdAt           DateTime            @default(now())

  @@index([workspaceId])
  @@index([invoiceId])
}

/**
 * TaxableEvent — persisted source row for a tax determination (invoice or expense).
 */
model TaxableEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sourceEntityKind       String // invoice | expense
  sourceEntityId         String
  taxableAmount          Decimal
  originCountryCode      String   @default("")
  destinationCountryCode String   @default("")
  occurredAt             DateTime

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  expenseId String?
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  determination TaxDetermination?

  createdAt DateTime @default(now())

  @@index([workspaceId, sourceEntityKind, sourceEntityId])
  @@index([workspaceId, occurredAt])
}

model TaxDetermination {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  taxableEventId String       @unique
  taxableEvent   TaxableEvent @relation(fields: [taxableEventId], references: [id], onDelete: Cascade)

  ratePercent      Float
  taxAmount        Decimal
  totalAmount      Decimal
  resolutionSource String // MANUAL_OVERRIDE | WORKSPACE_RULE | FALLBACK
  resolutionReason String
  overrideId       String?

  componentLines TaxComponentLine[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

model TaxComponentLine {
  id                 String           @id @default(cuid())
  workspaceId        String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taxDeterminationId String
  taxDetermination   TaxDetermination @relation(fields: [taxDeterminationId], references: [id], onDelete: Cascade)

  componentKey  String
  ratePercent   Float
  taxableAmount Decimal
  taxAmount     Decimal

  createdAt DateTime @default(now())

  @@index([workspaceId, taxDeterminationId])
}

/**
 * TaxAuditEvent — append-only audit trail for tax operations (correlation-friendly).
 */
model TaxAuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  eventType     String // DETERMINATION | READINESS_RUN | IMPORT_BATCH | DOCUMENT_LINK | RETURN_PERIOD_FILED
  correlationId String?
  actorUserId   String?
  entityType    String?
  entityId      String?
  payloadJson   Json

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, correlationId])
  @@index([workspaceId, eventType, createdAt(sort: Desc)])
}

/**
 * TaxOperationIdempotency — dedupe readiness runs and import batches per workspace + key.
 */
model TaxOperationIdempotency {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  operation      String // TAX_READINESS_RUN | TAX_IMPORT_BATCH
  idempotencyKey String
  requestHash    String
  responseBody   Json?
  status         String   @default("CONSUMED") // PENDING | CONSUMED
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, operation, idempotencyKey])
  @@index([workspaceId, expiresAt])
}

/**
 * TaxReferenceEntry — global India compliance catalog (seeded reference data).
 */
model TaxReferenceEntry {
  id          String     @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  entryType     String // TAX_TYPE | FILING_FREQUENCY | CORE_FORM | BASELINE_RATE | CALENDAR_RULE
  countryCode   String    @default("IN")
  code          String
  label         String?
  payloadJson   Json
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  sourceDocumentRef      Json?
  verificationLevel      String?
  reviewStatus           String?
  legalCertaintyRequired Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entryType, countryCode, code])
  @@index([workspaceId, entryType])
  @@index([countryCode, entryType])
}

model TaxPeriod {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  countryCode String    @default("IN")
  periodCode  String
  periodType  String    @default("QUARTER")
  fiscalYear  String
  startDate   DateTime
  endDate     DateTime
  dueDate     DateTime?
  isClosed    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxReturns TaxReturn[]

  @@unique([workspaceId, periodCode])
  @@index([workspaceId, startDate, endDate])
}

model TaxForm {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  countryCode  String          @default("IN")
  returnFamily TaxReturnFamily
  formCode     String
  version      String          @default("1.0")
  title        String?
  schemaJson   Json?
  isActive     Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxReturns TaxReturn[]

  @@unique([workspaceId, formCode, version])
  @@index([workspaceId, countryCode, returnFamily, isActive])
}

model TaxReturn {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  taxPeriodId String
  taxPeriod   TaxPeriod @relation(fields: [taxPeriodId], references: [id], onDelete: Cascade)

  taxFormId String
  taxForm   TaxForm @relation(fields: [taxFormId], references: [id], onDelete: Cascade)

  status                 TaxReturnStatus @default(DRAFT)
  readinessScore         Int             @default(0)
  lastReadinessCheckedAt DateTime?
  prefillCompletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fieldValues TaxReturnFieldValue[]
  blockers    TaxReadinessBlocker[]

  @@unique([workspaceId, taxPeriodId, taxFormId])
  @@index([workspaceId, status])
  @@index([workspaceId, lastReadinessCheckedAt])
  @@index([workspaceId, updatedAt(sort: Desc)])
}

model TaxReturnFieldValue {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  taxReturnId String
  taxReturn   TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)

  fieldKey        String
  fieldLabel      String?
  valueJson       Json
  sourceType      String
  sourceRef       String?
  confidenceScore Float?
  isManual        Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([taxReturnId, fieldKey])
  @@index([workspaceId, taxReturnId])
}

model TaxReadinessCheck {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  countryCode    String               @default("IN")
  returnFamily   TaxReturnFamily
  checkCode      String
  title          String
  description    String?
  severity       TaxReadinessSeverity @default(WARNING)
  ruleConfigJson Json?
  isActive       Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blockers TaxReadinessBlocker[]

  @@unique([workspaceId, returnFamily, checkCode])
  @@index([workspaceId, returnFamily, isActive])
}

model TaxReadinessBlocker {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  taxReturnId String
  taxReturn   TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)

  checkId String?
  check   TaxReadinessCheck? @relation(fields: [checkId], references: [id], onDelete: SetNull)

  blockerCode String
  title       String
  details     String?
  severity    TaxReadinessSeverity      @default(WARNING)
  status      TaxReadinessBlockerStatus @default(OPEN)
  factsJson   Json?

  detectedAt DateTime  @default(now())
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([taxReturnId, blockerCode])
  @@index([workspaceId, status, severity])
  @@index([workspaceId, taxReturnId])
  @@index([workspaceId, status, severity, updatedAt(sort: Desc)])
}

model InvoiceIdempotency {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  idempotencyKey String
  requestHash    String
  invoiceId      String?
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  responseBody   Json?
  status         String    @default("PENDING") // "PENDING" | "CONSUMED"
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, expiresAt])
}

model InvoiceGenerationDraft {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUserId   String
  payloadJson       Json
  totalsJson        Json
  currency          String
  status            String    @default("PENDING") // "PENDING" | "CONFIRMED" | "EXPIRED" | "CANCELLED"
  razorpayLinkId    String?
  razorpayLinkUrl   String?
  expiresAt         DateTime
  consumedAt        DateTime?
  finalizedInvoiceId String?
  finalizedInvoice   Invoice?  @relation("InvoiceGenerationDraftFinalizedInvoice", fields: [finalizedInvoiceId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId, createdByUserId, status])
  @@index([workspaceId, expiresAt])
}

model Expense {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  date        DateTime
  category    String
  vendor      String
  amount      Decimal
  description String?
  receiptUrl  String?
  createdAt   DateTime @default(now())

  withholdingRatePercent    Decimal?
  withholdingAmount         Decimal?
  withholdingDeductedAt     DateTime?
  withholdingDepositedAt    DateTime?
  withholdingDepositDueAt   DateTime?
  withholdingReminderSentAt DateTime?

  withholdingEvents WithholdingEvent[]
  taxableEvents     TaxableEvent[]

  // GST on purchases (input tax credit). `amount` is the total paid including GST.
  vendorGstin      String?
  vendorInvoiceNo  String?
  vendorStateCode  String?
  hsnCode          String?
  gstRate          Float?
  cgstAmount       Decimal @default(0)
  sgstAmount       Decimal @default(0)
  igstAmount       Decimal @default(0)
  cessAmount       Decimal @default(0)
  // NONE (no GST on the bill) | ELIGIBLE | INELIGIBLE (blocked u/s 17(5)) | REVERSE_CHARGE
  itcStatus        String  @default("NONE")
  // Rule 37: credit is reversed if the supplier is not paid within 180 days of the invoice (re-claimed once paid).
  paymentStatus    String    @default("PAID") // PAID | UNPAID
  paidAt           DateTime?
  // Credit control: hold a bill's credit (e.g. supplier has not filed) or claim it in a later month than the bill's.
  itcHeld          Boolean   @default(false)
  itcClaimMonth    String? // "2026-10"
  // MSME vendors: section 43B(h) disallows payments to micro and small enterprises made after the allowed days.
  vendorUdyam      String?
  vendorMsme       String? // MICRO | SMALL | MEDIUM | NONE (trader or unknown)
  vendorAgreedDays Int? // written credit period, max 45

  // Vendor master, bill due date and where the entry came from.
  vendorId String?
  vendorRecord Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  dueDate  DateTime?
  source   String   @default("MANUAL") // MANUAL | SCAN | EMAIL | RECURRING | PO | BANK | IMPORT | AI
  purchaseOrderId String?
  recurringId String?
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  // Approval: only APPROVED entries count in reports, tax and the dashboard.
  approvalStatus   String    @default("APPROVED") // DRAFT (needs review) | PENDING | APPROVED | REJECTED
  submittedByUserId String?
  approvedByUserId  String?
  approvedAt        DateTime?
  rejectionReason   String?

  // Billable to a client: can be added to the next invoice, with an optional markup.
  billable        Boolean  @default(false)
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  markupPercent   Float?
  billedInvoiceId String?

  @@index([date])
  @@index([category])
  @@index([workspaceId])
  @@index([workspaceId, date])
  @@index([workspaceId, approvalStatus])
  @@index([workspaceId, paymentStatus, dueDate])
  @@index([vendorId])
  @@index([clientId, billable])
  @@index([purchaseOrderId])
}

/// A supplier. Carries GST, MSME, terms and TDS defaults so each bill does not re-key them.
model Vendor {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  /// Lower-cased, punctuation-free name used to find the same vendor typed differently.
  nameKey     String
  gstin       String?
  stateCode   String?
  email       String?
  phone       String?
  msmeClass   String?  // MICRO | SMALL | MEDIUM | NONE
  udyam       String?
  paymentTermsDays Int?
  defaultCategory  String?
  /// Suggested withholding for payments to this vendor.
  tdsSection        String?
  tdsRatePercent    Float?
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses  Expense[]
  recurring RecurringExpense[]

  @@unique([workspaceId, nameKey])
  @@index([workspaceId, archivedAt])
}

/// A repeating expense (rent, subscriptions). Posts on its own or creates a draft to confirm.
model RecurringExpense {
  id          String   @id @default(cuid())
  workspaceId String
  vendorId    String?
  vendorRecord Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendor      String
  category    String
  amount      Decimal
  description String?
  frequency   String   @default("MONTHLY") // WEEKLY | MONTHLY | QUARTERLY | YEARLY
  nextRunDate DateTime
  endDate     DateTime?
  /// true: posts approved on its date; false: creates a draft for someone to confirm.
  autoPost    Boolean  @default(false)
  status      String   @default("ACTIVE") // ACTIVE | PAUSED | ENDED
  paymentStatus String @default("PAID") // PAID | UNPAID
  dueInDays   Int?
  itcStatus   String   @default("NONE")
  gstRate     Float?
  lastRunAt   DateTime?
  createdByUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses Expense[]

  @@index([workspaceId, status, nextRunDate])
}

/// Monthly cap per category (category "*" is the overall cap).
model ExpenseBudget {
  id          String   @id @default(cuid())
  workspaceId String
  category    String
  monthlyAmount Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, category])
}

/// Per-workspace expense rules and the forwarding inbox.
model ExpenseSettings {
  workspaceId       String   @id
  approvalRequired  Boolean  @default(false)
  /// With approval on, entries at or above this amount wait for an approver (0 = all).
  approvalThreshold Decimal  @default(0)
  inboxEnabled      Boolean  @default(false)
  inboxToken        String?  @unique
  updatedAt         DateTime @updatedAt
}

model WithholdingEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sourceType String // INVOICE_PAYMENT|EXPENSE_PAYMENT|MANUAL
  sourceId   String?
  invoiceId  String?
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  expenseId  String?
  expense    Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  counterpartyName String?
  sectionCode      String?

  grossAmount            Decimal
  withheldAmount         Decimal
  withholdingRatePercent Decimal?

  deductedAt     DateTime
  depositedAt    DateTime?
  depositDueAt   DateTime?
  reminderSentAt DateTime?

  returnPeriodKey String?
  notes           String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId, deductedAt])
  @@index([workspaceId, returnPeriodKey])
  @@index([workspaceId, sourceType, sourceId])
}

model TaxCreditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sourceType String // WITHHOLDING_CERTIFICATE|MANUAL|IMPORT
  sourceId   String?

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  creditType        String  @default("WITHHOLDING") // WITHHOLDING|ADVANCE_TAX|OTHER
  counterpartyName  String?
  certificateNumber String?

  grossAmount    Decimal?
  creditedAmount Decimal
  withheldAmount Decimal?

  certificateIssuedAt DateTime?
  periodStart         DateTime?
  periodEnd           DateTime?
  returnPeriodKey     String?

  status String  @default("POSTED") // POSTED|REVERSED|PENDING_REVIEW
  notes  String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ledgerEntries TaxCreditLedgerEntry[]

  @@index([workspaceId, returnPeriodKey])
  @@index([workspaceId, periodStart, periodEnd])
  @@index([workspaceId, documentId])
