  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([taxReturnId, fieldKey])
  @@index([workspaceId, taxReturnId])
}

model TaxReadinessCheck {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  countryCode    String               @default("IN")
  returnFamily   TaxReturnFamily
  checkCode      String
  title          String
  description    String?
  severity       TaxReadinessSeverity @default(WARNING)
  ruleConfigJson Json?
  isActive       Boolean              @default(true)

