  type String
  severity String @default("INFO")
  status String @default("OPEN")
  title String
  description String
  suggestedAction String?
  oldValueJson Json?
  newValueJson Json?
  metadataJson Json?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  resolvedByUserId String?

