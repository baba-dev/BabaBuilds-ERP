  subscriptions MailBillingSubscription[]
  reviewItems MailBillingReviewItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, serverId, domain])
  @@index([workspaceId, clientId])
  @@index([workspaceId, retainerId])
  @@index([workspaceId, status])
