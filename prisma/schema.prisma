generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" // Or "file:../dev.db" depending on your folder structure
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum WorkspaceTaxMode {
  AUTO
  AUTO_WITH_OVERRIDE
  MANUAL
}

enum TaxOverrideScopeType {
  GLOBAL
  COUNTRY
  REGION
  SERVICE
  CUSTOMER
}

enum TaxResolutionSource {
  MANUAL_OVERRIDE
  WORKSPACE_RULE
  PROVIDER
  FALLBACK
}

enum AccountingEventType {
  INVOICE_CREATED
  PAYMENT_CAPTURED
  REFUND_ISSUED
  CREDIT_NOTE_ISSUED
  CHARGEBACK_RECORDED
  FX_CONVERSION_RECORDED
  WRITE_OFF_RECORDED
  MANUAL_ADJUSTMENT
}

enum AccountingLineSide {
  DEBIT
  CREDIT
}

// ==========================================
// 1. AUTHENTICATION (NextAuth Standard)
// ==========================================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String? // This acts as the Avatar URL
  role          String    @default("USER") // "USER", "ADMIN"

  // --- NEW: PERSONAL PREFERENCES ---
  theme              String @default("system") // "light", "dark", "system"
  dateFormat         String @default("DD/MM/YYYY")
  timeZone           String @default("Asia/Kolkata")
  locale             String @default("en-IN") // Formatting rules (e.g., en-IN, en-US)
  currencyFormat     String @default("INR") // Currency symbol/math (e.g., INR, USD)
  defaultLandingPage String @default("/dashboard") // e.g., "/dashboard", "/invoice", "/clients"

  // --- NOTIFICATION SETTINGS ---
  transactionalAlerts Boolean @default(true) // E.g., "Invoice Paid" alerts
  marketingEmails     Boolean @default(false) // Product updates/news
  weeklyReport        Boolean @default(true) // AI Financial Summary emails
  // Granular channel toggles (user-configurable per channel)
  notifyEmail         Boolean @default(true)
  notifyPush          Boolean @default(true)
  notifyInApp         Boolean @default(true)

  // --- RELATIONS ---
  accounts           Account[]
  sessions           Session[]
  workspaces         WorkspaceUser[]
  appActivities      AppActivityLog[]    @relation("AppActivityActor")
  pushSubscriptions  PushSubscription[]
  inAppNotifications InAppNotification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// 2. MULTI-TENANCY & BILLING (The "Workspace")
// ==========================================
model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // --- NEW: GLOBALIZATION STATE ---
  isSetupComplete Boolean @default(false) // Triggers the Popup Wizard
  countryCode     String  @default("IN") // ISO 2-letter code (US, AE, GB, IN)
  baseCurrency    String  @default("INR") // Functional currency for reports

  // --- EXISTING BILLING ---
  subscriptionStatus   String    @default("FREE") // "TRIALING", "PRO", "FREE", "SUSPENDED"
  subscriptionEndsAt   DateTime?
  planTier             String    @default("FREE") // "FREE", "PRO"
  currentMonthInvoices Int       @default(0)

  planInterval      String? // "MONTHLY", "QUARTERLY", "YEARLY"
  paymentMethodMask String? // e.g., "•••• 4242" or "user@upi"
  billingProviderId String? // Stripe/Razorpay Customer ID

  updatedAt DateTime @default(now()) @updatedAt

  // RELATIONS
  users                      WorkspaceUser[]
  businessProfile            BusinessProfile?
  clients                    Client[]
  invoices                   Invoice[]
  billingTransactions        BillingTransaction[]
  expenses                   Expense[]
  bankTransactions           BankTransaction[]
  investments                Investment[]
  serviceTemplates           ServiceTemplate[]
  proposals                  Proposal[]
  retainers                  Retainer[]
  tasks                      Task[]
  invoiceIdempotencies       InvoiceIdempotency[]
  taxPreference              WorkspaceTaxPreference?
  workspaceTaxOverrides      WorkspaceTaxOverride[]
  taxRateOverrides           TaxRateOverride[]
  taxRateOverrideAuditLogs   TaxRateOverrideAuditLog[]
  taxDecisionAuditLogs       TaxDecisionAuditLog[]
  fileImportAuditLogs        FileImportAuditLog[]
  appActivityLogs            AppActivityLog[]
  workspaceInvites           WorkspaceInvite[]
  accountingTransactions     AccountingTransaction[]
  accountingIntegrityRuns    AccountingIntegrityRun[]
  accountingViolationReports AccountingViolationReport[]

  // IMS Relations
  products           Product[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  accountingEntries  AccountingEntry[]
}

model AppActivityLog {
  id String @id @default(cuid())

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  actorUserId String?
  actorUser   User?   @relation("AppActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String?

  action     String
  entityType String?
  entityId   String?

  status   String // "SUCCESS" | "FAILURE" | "WARNING" | "INFO"
  metadata Json?

  ipAddress     String?
  userAgent     String?
  correlationId String?

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}

model BillingTransaction {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  transactionDate   DateTime @default(now())
  amount            Decimal  @default(0)
  status            String   @default("PAID") // "PAID", "PENDING", "FAILED", etc.
  description       String
  providerReference String?
  receiptUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, transactionDate])
}

model AccountingTransaction {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  eventType       AccountingEventType
  eventOccurredAt DateTime
  postedAt        DateTime            @default(now())
  postingCurrency String
  exchangeRate    Decimal?
  description     String?

  sourceTable      String
  sourceId         String
  sourceRef        String?
  requestId        String?
  jobId            String?
  statementBatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries AccountingEntry[]

  @@unique([workspaceId, sourceTable, sourceId, eventType])
  @@index([workspaceId, eventType, postedAt])
  @@index([workspaceId, sourceTable, sourceId])
  @@index([requestId])
  @@index([jobId])
}

model AccountingEntry {
  id String @id @default(cuid())

  transactionId String
  transaction   AccountingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  lineNumber  Int
  accountCode String
  side        AccountingLineSide
  amount      Decimal
  currency    String
  postedAt    DateTime
  isPosted    Boolean            @default(true)

  createdAt DateTime @default(now())

  @@unique([transactionId, lineNumber])
  @@index([workspaceId, accountCode, postedAt])
  @@index([workspaceId, transactionId])
}

model AccountingIntegrityRun {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  runType     String    @default("NIGHTLY")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("RUNNING")
  summary     Json?

  violations AccountingViolationReport[]

  @@index([workspaceId, startedAt(sort: Desc)])
}

model AccountingViolationReport {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  runId String
  run   AccountingIntegrityRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  invariantCode String
  severity      String   @default("ERROR")
  details       Json
  detectedAt    DateTime @default(now())

  @@index([workspaceId, detectedAt(sort: Desc)])
  @@index([runId, invariantCode])
}

model WorkspaceUser {
  id          String @id @default(cuid())
  userId      String
  workspaceId String
  role        String @default("OWNER") // "OWNER", "MEMBER"

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        String   @default("MEMBER") // "OWNER", "ADMIN", "MEMBER", "VIEWER"
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

// ==========================================
// 3. SECURED BUSINESS DATA
// ==========================================

model BusinessProfile {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  companyName    String
  proprietorName String
  address        String
  email          String
  phone          String?
  website        String?

  invoiceTheme String @default("DESIGN_1") // "DESIGN_1" or "DESIGN_2"

  // --- DYNAMIC TAX LABELS ---
  // In the UI, instead of "Enter GST", we show "Enter {taxLabel}"
  taxLabel     String @default("GST") // "VAT", "Sales Tax", "GST"
  taxIdLabel   String @default("GSTIN") // "TRN", "EIN", "GSTIN"
  routingLabel String @default("IFSC Code") // "SWIFT", "Sort Code", "ABA"

  // Compliance (Keeping legacy names for no-break compatibility)
  panNumber   String // Acts as Primary Tax ID
  udyamNumber String? // Acts as Secondary Business ID
  gstin       String? // Acts as the Regional Tax ID

  // Banking
  bankName      String
  accountName   String
  accountNumber String
  ifscCode      String // General routing code

  logoUrl        String?
  signatureUrl   String?
  groqApiKey     String?
  defaultSacCode String? @default("998313") // Default IT Consulting if not specified
  defaultTaxRate Float?

  // PAYMENT GATEWAY (Per-Tenant Razorpay Keys — PRO users only)
  razorpayKeyId     String? // Plain text (publishable key, e.g. rzp_live_xxx)
  razorpayKeySecret String? // AES-256-GCM encrypted blob (NEVER stored plain)

  // PAYMENT GATEWAY — Stripe (PRO users only, global)
  stripePublishableKey String? // Plain text (pk_live_xxx)
  stripeSecretKey      String? // AES-256-GCM encrypted blob (NEVER stored plain)
  defaultGateway       String? @default("RAZORPAY") // "RAZORPAY" | "STRIPE"

  // EMAIL SERVER (SMTP)
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPassword  String?
  smtpFromEmail String?

  updatedAt DateTime @updatedAt
}

model Client {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name    String
  address String
  country String
  taxId   String?
  email   String?
  phone   String?
  logoUrl String?

  status String @default("ACTIVE") // "ACTIVE", "INACTIVE", "VIP"

  // "isExport" becomes "isTaxExempt" in global context
  isExport Boolean @default(true)

  createdAt DateTime   @default(now())
  invoices  Invoice[]
  proposals Proposal[]
  retainers Retainer[]

  @@unique([name, workspaceId])
  @@index([workspaceId])
}

model Invoice {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  invoiceNumber      String
  financialYear      String
  billingMonth       String   @default("Unknown")
  invoiceDate        DateTime
  clientName         String
  sacCode            String? // Removed the hardcoded @default("998313")
  serviceDescription String

  subtotal    Decimal  @default(0)
  taxRate     Float    @default(0)
  taxAmount   Decimal  @default(0)
  grandTotal  Decimal  @default(0)
  taxMode     String   @default("exempt") // "taxable" | "exempt"
  totalAmount Decimal
  pdfPath     String
  createdAt   DateTime @default(now())

  status         InvoiceStatus @default(PENDING)
  amountReceived Float?
  dateReceived   DateTime?

  clientId             String?
  client               Client?               @relation(fields: [clientId], references: [id])
  idempotencyRecords   InvoiceIdempotency[]
  taxDecisionAuditLogs TaxDecisionAuditLog[]
  items                InvoiceItem[]

  // Security: Two different workspaces can use invoice number "001"
  @@unique([invoiceNumber, workspaceId])
  @@index([financialYear])
  @@index([workspaceId])
}

model WorkspaceTaxPreference {
  id                 String           @id @default(cuid())
  workspaceId        String           @unique
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mode               WorkspaceTaxMode @default(AUTO)
  defaultCountryCode String?
  provider           String?
  updatedBy          String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model WorkspaceTaxOverride {
  id            String               @id @default(cuid())
  workspaceId   String
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scopeType     TaxOverrideScopeType
  scopeKey      String
  ratePercent   Float
  reason        String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  priority      Int                  @default(0)
  isActive      Boolean              @default(true)
  createdBy     String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([workspaceId, isActive, effectiveFrom, effectiveTo])
  @@index([workspaceId, scopeType, scopeKey, priority])
}

model TaxDecisionAuditLog {
  id                  String              @id @default(cuid())
  workspaceId         String
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId           String?
  invoice             Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  resolvedRatePercent Float
  resolutionSource    TaxResolutionSource
  basisJson           Json
  inputHash           String
  createdBy           String
  createdAt           DateTime            @default(now())

  @@index([workspaceId])
  @@index([invoiceId])
}

model InvoiceIdempotency {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  idempotencyKey String
  requestHash    String
  invoiceId      String?
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  responseBody   Json?
  status         String    @default("PENDING") // "PENDING" | "CONSUMED"
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, expiresAt])
}

model Expense {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  date        DateTime
  category    String
  vendor      String
  amount      Decimal
  description String?
  receiptUrl  String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([category])
  @@index([workspaceId])
}

model BankTransaction {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  date        DateTime
  description String
  amount      Decimal // Positive for deposits, negative for withdrawals
  referenceId String?

  // Reconciliation state
  isReconciled     Boolean @default(false)
  matchedInvoiceId String?
  matchedExpenseId String?

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([date])
}

model Investment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  date      DateTime
  category  String
  assetName String
  amount    Decimal
  createdAt DateTime @default(now())

  @@index([date])
  @@index([category])
  @@index([workspaceId])
}

// ==========================================
// 4. GLOBAL COMPLIANCE DICTIONARIES (Read-Only)
// ==========================================

model NICCode {
  id          String  @id @default(cuid())
  code        String  @unique // e.g., "62012"
  description String // e.g., "Web-page designing"
  countryCode String  @default("IN") // "IN" for India, "US", "GB", etc.
  isCustom    Boolean @default(false)

  services ServiceTemplate[]
}

model SACCode {
  id          String  @id @default(cuid())
  code        String  @unique // e.g., "998313"
  description String // e.g., "IT Consulting Services"
  igstRate    Float   @default(18.0) // Default GST rate
  countryCode String  @default("IN")
  isCustom    Boolean @default(false)

  services ServiceTemplate[]
}

// ==========================================
// 5. PROPOSALS & SERVICE CATALOG (Workspace-Scoped)
// ==========================================

// The user's saved list of services (e.g., "Monthly SEO Retainer")
model ServiceTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  defaultPrice Decimal @default(0)

  // Relational Links to the Global Dictionaries
  nicCodeId String?
  nicCode   NICCode? @relation(fields: [nicCodeId], references: [id])

  sacCodeId String?
  sacCode   SACCode? @relation(fields: [sacCodeId], references: [id])

  proposalItems ProposalItem[]

  @@index([workspaceId])
}

model Proposal {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  proposalNo String // e.g., "EST-2024-001"
  title      String // e.g., "Q3 Marketing Campaign"
  status     String @default("DRAFT") // DRAFT, SENT, VIEWED, ACCEPTED, DECLINED, INVOICED

  dateCreated DateTime @default(now())
  validUntil  DateTime

  // The Public Link token (e.g., bababuilds.com/p/abc123xyz)
  publicToken String @unique @default(cuid())

  // E-Signature Data
  acceptedAt DateTime?
  clientIp   String?

  items ProposalItem[]

  subtotal     Decimal
  estimatedTax Decimal @default(0)
  totalAmount  Decimal

  @@unique([proposalNo, workspaceId])
  @@index([workspaceId])
  @@index([publicToken])
}

model ProposalItem {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  serviceTemplateId String?
  serviceTemplate   ServiceTemplate? @relation(fields: [serviceTemplateId], references: [id])

  title       String // Copied from template so it can be edited per-proposal
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal
  total       Decimal
}

model Retainer {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // The Billing Details
  amount    Decimal
  frequency String  @default("MONTHLY") // "MONTHLY", "QUARTERLY", "ANNUALLY"
  status    String  @default("ACTIVE") // "ACTIVE", "PAUSED", "CANCELLED"

  // The Automation Engine
  nextBillingDate DateTime
  autoAppendMonth Boolean  @default(true) // The "Zero-Effort" Toggle

  // What exactly are we billing them for?
  serviceName String
  sacCode     String?
  taxRate     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("PENDING")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model TaxRateOverride {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  scopeType String  @default("WORKSPACE") // "WORKSPACE" | "CLIENT" | "SERVICE"
  scopeRef  String?

  rate          Float
  effectiveFrom DateTime
  effectiveTo   DateTime?
  reason        String?

  isActive      Boolean   @default(true)
  deactivatedAt DateTime?

  createdByUserId String?
  createdByEmail  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs TaxRateOverrideAuditLog[]

  @@index([workspaceId, scopeType, isActive])
  @@index([workspaceId, effectiveFrom])
}

model TaxRateOverrideAuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  taxRateOverrideId String?
  taxRateOverride   TaxRateOverride? @relation(fields: [taxRateOverrideId], references: [id], onDelete: SetNull)

  action         String // "CREATE" | "UPDATE" | "DEACTIVATE"
  decisionSource String @default("OVERRIDE") // "AUTO" | "OVERRIDE" | "FALLBACK"

  scopeType String
  scopeRef  String?
  rate      Float?

  effectiveFrom DateTime?
  effectiveTo   DateTime?
  reason        String?

  previousValues Json?
  newValues      Json?

  actorUserId String?
  actorEmail  String?

  prevHash         String?
  entryHash        String?
  canonicalPayload Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action])
  @@index([workspaceId, scopeType])
}

model FileImportAuditLog {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  fileName      String?
  mimeType      String?
  fileSizeBytes Int?
  flow          String?
  status        String
  reason        String?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

// ==========================================
// 7. NOTIFICATION SYSTEM
// ==========================================

/// Stores Web Push API subscriptions (one per browser/device per user)
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String  @unique
  p256dh    String // Browser-generated public key
  auth      String // Browser-generated auth secret
  userAgent String? // Optional: identify device

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Persisted in-app notifications for the Bell UI / Sonner polling
model InAppNotification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Event type: INVOICE_GENERATED | CLIENT_ADDED | RENEWAL_ALERT | PAYMENT_REMINDER | TAX_ALERT | DEADLINE_ALERT | PROPOSAL_CREATED | SERVICE_CREATED
  eventType String
  title     String
  body      String
  /// Deep-link URL to navigate to on click
  actionUrl String?
  isRead    Boolean   @default(false)
  readAt    DateTime?

  /// Optional workspace context
  workspaceId String?

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([workspaceId])
}

// ==========================================
// 8. INVENTORY MANAGEMENT SYSTEM
// ==========================================

model Product {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sku         String
  name        String
  description String?
  category    String?
  unit        String  @default("pcs")

  // Cost & Valuation
  baselinePrice Decimal @default(0)
  costPrice     Decimal @default(0)

  // Stock Levels
  currentStock Int    @default(0)
  safetyStock  Int    @default(5)
  status       String @default("IN_STOCK") // "IN_STOCK", "LOW_STOCK", "OUT_OF_STOCK"

  barcode  String? // For zero-latency search
  imageUrl String? // Product image
  location String? // e.g., "Warehouse A", "Van 1"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements     InventoryMovement[]
  invoiceItems  InvoiceItem[]
  purchaseItems PurchaseOrderItem[]

  @@unique([sku, workspaceId])
  @@index([workspaceId])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal
  taxRate     Float   @default(0)
  totalAmount Decimal

  @@index([invoiceId])
  @@index([productId])
}

model InventoryMovement {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     String // "IN" (Purchase, Return), "OUT" (Sale, Damage, Loss), "ADJ" (Manual Adjustment)
  quantity Int // Positive for IN, Negative for OUT/ADJ if reducing
  reason   String? // e.g., "Invoice #101 Payment", "Manual Sync", "Found behind shelf"

  referenceId String? // ID of Invoice or PO

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([productId])
  @@index([createdAt])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  poNumber String
  supplier String
  status   String @default("DRAFT") // "DRAFT", "SENT", "DELIVERED", "CANCELLED"

  expectedDate DateTime?
  totalAmount  Decimal   @default(0)

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([poNumber, workspaceId])
  @@index([workspaceId])
}

model PurchaseOrderItem {
  id            String        @id @default(cuid())
  poId          String
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity      Int
  unitPrice     Decimal
  expectedTotal Decimal
}
