  name        String
  provider    String    @default("MIAB")
  accessMode  String    @default("READ_ONLY_ADAPTER")
  baseUrl        String
  encryptedToken String?
  status         String    @default("ACTIVE")
  lastSyncAt     DateTime?
  lastSyncStatus String?
  lastSyncError  String?

  domains   MailBillingDomain[]
  mailboxes MailBillingMailbox[]
  syncRuns  MailBillingSyncRun[]
  reviewItems MailBillingReviewItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
}

model MailBillingDomain {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  serverId String
  server   MailBillingServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  domain String

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  retainerId String?
  retainer   Retainer? @relation(fields: [retainerId], references: [id], onDelete: SetNull)

  status       String @default("ACTIVE")
  mailboxCount Int    @default(0)
  aliasCount   Int    @default(0)
  billingMode  String @default("DOMAIN_PLAN")
  billingNotes String?

  discoveredAt DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  archivedAt   DateTime?
