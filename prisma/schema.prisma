  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  taxPeriodId String
  taxPeriod   TaxPeriod @relation(fields: [taxPeriodId], references: [id], onDelete: Cascade)

