  entryType       String // CREDIT|REVERSAL|ADJUSTMENT
  amount          Decimal
  entryDate       DateTime
  returnPeriodKey String?
  notes           String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([workspaceId, entryDate])
  @@index([workspaceId, returnPeriodKey])
  @@index([workspaceId, taxCreditEventId])
}

model TaxReturnPeriod {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  periodKey   String
  periodStart DateTime
  periodEnd   DateTime

  dueDate DateTime
  filedAt DateTime?

  expectedWithheldAmount   Decimal @default(0)
  reconciledWithheldAmount Decimal @default(0)

  status String  @default("OPEN") // OPEN|FILED|OVERDUE
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, periodKey])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, periodStart, periodEnd])
}

model BankTransaction {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  accountId String?
  account   BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  importBatchId String?
  importBatch   BankImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  /// Stable id from aggregator (Plaid) or ISO20022 — dedupe independent of narration.
  providerTransactionId String?

  date                     DateTime
  description              String
  amount                   Decimal // Account currency: positive deposits, negative withdrawals
  referenceId              String?
  transactionType          String?
  isInternalTransfer       Boolean  @default(false)
  reconciliationConfidence Float?
  category                 String?

  /// Statement running balance after row (when source file had a balance column).
  balanceAfter Decimal?

  /// Original statement currency when different from account (optional).
  originalCurrency       String?
  /// Amount in originalCurrency when FX column mapped (optional).
  amountOriginalCurrency Decimal?

  /// JSON: balance continuity flags, parse warnings, suggested invoice ids, etc.
  parseFlagsJson Json?

  // Reconciliation state
  isReconciled     Boolean @default(false)
  matchedInvoiceId String?
  matchedExpenseId String?

  /// Dedupe key for imports: workspace + account + stable row fingerprint (hash).
  sourceImportHash String?

  /// Set when someone decides this line needs no match (kept out of the review inbox until restored).
  ignoredAt DateTime?

  createdAt DateTime @default(now())

  invoiceSplits BankTransactionInvoiceSplit[]

  @@unique([workspaceId, accountId, sourceImportHash])
  @@unique([workspaceId, accountId, providerTransactionId])
  @@index([workspaceId])
  @@index([accountId])
  @@index([date])
  @@index([workspaceId, isReconciled, date])
  @@index([workspaceId, isReconciled, ignoredAt])
  @@index([importBatchId])
}

model BankAccount {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name                String
  bankName            String?
  accountHolderName   String?
  maskedAccountNumber String?
  routingCode         String?
  sourceType          String? @default("MANUAL")
  isPrimaryRemittance Boolean @default(false)
  currency            String  @default("INR")

  openingBalance     Decimal  @default(0)
  openingBalanceDate DateTime @default(now())

  // Optional cached value; source of truth is openingBalance + transactions.
  currentBalance Decimal?

  transactions  BankTransaction[]
  importBatches BankImportBatch[]
  primaryForBusinessProfiles BusinessProfile[] @relation("PrimaryRemittanceBankAccount")

  /// Plaid Item + account (encrypted token at rest)
  plaidItemId               String?
  plaidAccountId            String?
  plaidAccessTokenEncrypted String?
  plaidTransactionsCursor   String?
  lastPlaidSyncAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, isPrimaryRemittance])
  @@index([workspaceId])
}

/// One uploaded bank file (CSV/XLSX/OFX/PDF) — audit trail for imports.
model BankImportBatch {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  fileName     String
  mimeType     String?
  rowCount     Int     @default(0)
  parseVersion String  @default("1")
  parseMeta    Json?
  status       String  @default("COMPLETED") // PENDING|COMPLETED|FAILED

  createdByUserId String?
  createdAt       DateTime @default(now())

  /// Optional raw file blob when workspace enables retention (governance).
  rawFileData Bytes?

  transactions BankTransaction[]

  @@index([workspaceId, accountId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

/// Workspace-scoped expense categories for reconciliation (replaces ad-hoc localStorage lists).
model ExpenseReconciliationCategory {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([workspaceId, name])
  @@index([workspaceId, sortOrder])
}

/// User-defined rules evaluated before AI (narration substring → category/vendor/internal transfer).
model BankReconciliationRule {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  priority            Int     @default(0)
  pattern             String
  matchTxnType        String  @default("ANY") // ANY|DEBIT|CREDIT
  setCategory         String?
  setVendor           String?
  setInternalTransfer Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, isActive, priority])
}

/// Tunable reconciliation thresholds and retention (PII governance).
model WorkspaceReconciliationSettings {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Auto-apply invoice match when score >= this (default 95).
  autoMatchMinScore      Float   @default(95)
  /// Surface top suggestions when score >= this but below autoMatchMinScore.
  autoMatchSuggestionMin Float   @default(70)
  /// Days to retain raw import payload in staging (0 = do not retain beyond parse).
  importRawRetentionDays Int     @default(0)
  /// When true, store raw file bytes in BankImportBatch.rawFileData (encrypted at app level optional future).
  storeRawImportBytes    Boolean @default(false)
  /// PLAID|NONE|GROQ — PLAID is stub until keys wired.
  bankFeedProvider       String  @default("NONE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Split one bank credit across multiple invoices (partial applications).
model BankTransactionInvoiceSplit {
  id                String          @id @default(cuid())
  bankTransactionId String
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Decimal

  createdAt DateTime @default(now())

  @@index([bankTransactionId])
  @@index([invoiceId])
}

model CashForecastSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  generatedAt DateTime                @default(now())
  horizonType CashForecastHorizonType
  scenarioTag CashForecastScenarioTag @default(BASE)

  startDate DateTime
  endDate   DateTime

  openingCash            Decimal @default(0)
  closingCash            Decimal @default(0)
  totalProjectedInflows  Decimal @default(0)
  totalProjectedOutflows Decimal @default(0)

  confidenceScore Float?
  assumptionsJson Json?
  generatedBy     CashForecastGeneratedBy @default(SYSTEM)

  createdAt DateTime @default(now())

  periods CashForecastPeriod[]

  @@index([workspaceId, horizonType, scenarioTag, generatedAt(sort: Desc)])
  @@index([workspaceId, startDate, endDate])
}

model CashForecastPeriod {
  id         String               @id @default(cuid())
  snapshotId String
  snapshot   CashForecastSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  bucketLabel String

  openingCash Decimal @default(0)

  actualInflows     Decimal @default(0)
  projectedInflows  Decimal @default(0)
  actualOutflows    Decimal @default(0)
  projectedOutflows Decimal @default(0)

  closingCash Decimal @default(0)

  riskLevel                 CashForecastRiskLevel @default(LOW)
  varianceFromPriorForecast Decimal?
  notesJson                 Json?

  lineItems CashForecastLineItem[]

  @@index([snapshotId, periodStart])
  @@index([snapshotId, riskLevel])
}

model CashForecastLineItem {
  id       String             @id @default(cuid())
  periodId String
  period   CashForecastPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  direction      CashForecastDirection
  sourceType     CashForecastSourceType
  sourceId       String?
  amount         Decimal
  expectedDate   DateTime
  confidence     Float?
  scenarioTag    CashForecastScenarioTag    @default(BASE)
  classification CashForecastClassification
  title          String
  metadataJson   Json?
  explanation    String?

  createdAt DateTime @default(now())

  @@index([periodId, expectedDate])
  @@index([sourceType, sourceId])
  @@index([classification])
}

model CashForecastAssumption {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  key           String
  valueJson     Json
  effectiveFrom DateTime?
  isActive      Boolean   @default(true)
  updatedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, key, isActive])
  @@index([workspaceId, isActive, key])
}

model CashForecastManualAdjustment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  date      DateTime
  amount    Decimal
  direction CashForecastDirection
  reason    String
  category  String?
  createdBy String?

  createdAt DateTime @default(now())

  @@index([workspaceId, date])
  @@index([workspaceId, direction])
}

model CashForecastLineItemPlan {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  horizonType CashForecastHorizonType
  scenarioTag CashForecastScenarioTag @default(BASE)

  // Stable identifier for a forecast driver across snapshots.
  // Typically derived from {sourceType, sourceId} (fallback to title hash).
  planKey String

  status String  @default("open") // "open" | "deferred" | "resolved"
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, horizonType, scenarioTag, planKey])
  @@index([workspaceId, horizonType, scenarioTag])
}

model CashForecastAlertPreference {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Keep this scoped and minimal in v1. Later: quiet hours, channels, per-alert thresholds.
  criticalEnabled Boolean @default(true)
  warningEnabled  Boolean @default(true)
  infoEnabled     Boolean @default(true)

  /// Last time the nightly job told the team about a coming shortfall, and which one, so the same warning is not sent every night.
  lastAlertAt  DateTime?
  lastAlertKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId])
}

model Investment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  date      DateTime
  category  String
  assetName String
  amount    Decimal
  createdAt DateTime @default(now())

  @@index([date])
  @@index([category])
  @@index([workspaceId])
}

// ==========================================
// 4. GLOBAL COMPLIANCE DICTIONARIES (Read-Only)
// ==========================================

model NICCode {
  id          String  @id @default(cuid())
  code        String  @unique // e.g., "62012"
  description String // e.g., "Web-page designing"
  countryCode String  @default("IN") // "IN" for India, "US", "GB", etc.
  isCustom    Boolean @default(false)

  services ServiceTemplate[]
}

model SACCode {
  id          String  @id @default(cuid())
  code        String  @unique // e.g., "998313"
  description String // e.g., "IT Consulting Services"
  igstRate    Float   @default(18.0) // Default GST rate
  countryCode String  @default("IN")
  isCustom    Boolean @default(false)

  services ServiceTemplate[]
}

// ==========================================
// 5. PROPOSALS & SERVICE CATALOG (Workspace-Scoped)
// ==========================================

// The user's saved list of services (e.g., "Monthly SEO Retainer")
model ServiceTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name         String
  description  String? // Short description (for invoices/proposals)
  defaultPrice Decimal @default(0)

  // E-STORE FIELDS
  longDescription String? // Rich HTML/markdown from Tiptap — shown on shop page
  imageUrl        String? // Hero image path e.g. /uploads/service-hero/xxx.webp

  // Relational Links to the Global Dictionaries
  nicCodeId String?
  nicCode   NICCode? @relation(fields: [nicCodeId], references: [id])

  sacCodeId String?
  sacCode   SACCode? @relation(fields: [sacCodeId], references: [id])

  proposalItems ProposalItem[]
  retainerItems RetainerItem[]

  @@index([workspaceId])
}

model Proposal {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  proposalNo String // e.g., "EST-2024-001"
  title      String // e.g., "Q3 Marketing Campaign"
  status     String @default("DRAFT") // DRAFT, SENT, VIEWED, ACCEPTED, DECLINED, INVOICED

  dateCreated DateTime @default(now())
  validUntil  DateTime

  // The Public Link token (e.g., bababuilds.com/p/abc123xyz)
  publicToken String @unique @default(cuid())

  // E-Signature & Lifecycle Data
  acceptedAt     DateTime?
  clientIp       String?
  acceptedByName String?

  sentAt           DateTime?
  sentByUserId     String?
  firstViewedAt    DateTime?
  lastViewedAt     DateTime?
  viewCount        Int       @default(0)
  declinedAt       DateTime?
  declineReason    String?
  firstConvertedAt DateTime?
  expiredAt        DateTime?

  richSections           Json?
  clientSignatureBase64  String?

  items                  ProposalItem[]
  conversions            ProposalConversion[]
  billingMilestones      BillingMilestone[]
  generatedInvoices      Invoice[]            @relation("ProposalToInvoice")
  generatedRetainers     Retainer[]           @relation("ProposalToRetainer")
  generatedShopOrders    ShopOrder[]          @relation("ProposalToShopOrder")

  subtotal     Decimal
  estimatedTax Decimal @default(0)
  totalAmount  Decimal

  // Pricing context frozen at save time, so the converted invoice matches what the client signed.
  currency       String  @default("INR")
  exchangeRate   Decimal @default(1)
  taxRatePercent Float   @default(0)
  // Bumped on every edit after the proposal was sent.
  revision       Int     @default(1)
  archivedAt     DateTime?
  // [{type:"image"|"video", url, title}] (previously smuggled into `declineReason`).
  richMedia      Json?
  events         ProposalEvent[]

  @@unique([proposalNo, workspaceId])
  @@index([workspaceId])
  @@index([publicToken])
  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@index([workspaceId, dateCreated])
}

/// Append-only client/owner timeline for a proposal (sent, viewed, revision requested, accepted, ...).
model ProposalEvent {
  id          String   @id @default(cuid())
  workspaceId String
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  type        String
  message     String?
  metadata    String?
  actorUserId String?
  createdAt   DateTime @default(now())

  @@index([proposalId, createdAt])
}

model ProposalItem {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  serviceTemplateId String?
  serviceTemplate   ServiceTemplate? @relation(fields: [serviceTemplateId], references: [id], onDelete: SetNull)

  title       String // Copied from template so it can be edited per-proposal
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal
  total       Decimal

  isOptional  Boolean  @default(false)
  isSelected  Boolean  @default(true)
  // Explicit "bills every month" flag; replaces guessing from words in the title.
  isRecurring Boolean  @default(false)
}

model Retainer {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // The Billing Details
  currency  String  @default("INR")
  frequency String  @default("MONTHLY") // "MONTHLY", "QUARTERLY", "ANNUALLY"
  status    String  @default("ACTIVE") // "ACTIVE", "PAUSED", "CANCELLED"

  // The Automation Engine
  nextBillingDate DateTime
  autoAppendMonth Boolean  @default(true) // The "Zero-Effort" Toggle

  sourceProposalId    String?
  sourceProposal      Proposal?            @relation("ProposalToRetainer", fields: [sourceProposalId], references: [id])
  proposalConversions ProposalConversion[]

  // Legacy fields (restored as optional to prevent deployment data loss)
  amount      Decimal?
  sacCode     String?
  serviceName String?

  items               RetainerItem[]
  meteredUsages       MeteredUsage[]
  mailBillingDomains  MailBillingDomain[]
  mailBillingSubscriptions MailBillingSubscription[]

  // Rework: lifecycle, schedule limits and billing state.
  name             String?
  notes            String?
  exchangeRate     Decimal   @default(1)
  paymentTermsDays Int       @default(7)
  emailInvoice     Boolean   @default(true)
  endDate          DateTime?
  maxCycles        Int?
  cyclesBilled     Int       @default(0)
  lastBilledAt     DateTime?
  lastError        String?
  lastErrorAt      DateTime?
  cancelledAt      DateTime?
  invoices         Invoice[]        @relation("RetainerInvoices")
  events           RetainerEvent[]
  priceChanges     RetainerPriceChange[]
  // Collections: automatic payment reminders for this retainer's overdue invoices.
  remindersEnabled Boolean @default(true)
  // Renewal: when the cycle limit / end date is reached, extend by `renewCycles` instead of completing.
  autoRenew        Boolean @default(false)
  renewCycles      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, nextBillingDate])
  @@index([workspaceId, clientId])
}

/// A scheduled price change: from the first cycle on/after `effectiveDate`, every line is multiplied by (1 + percent/100).
model RetainerPriceChange {
  id            String    @id @default(cuid())
  workspaceId   String
  retainerId    String
  retainer      Retainer  @relation(fields: [retainerId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  percent       Float
  note          String?
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([retainerId, effectiveDate])
}

/// Append-only history of a retainer (created, edited, paused, billed, failed, ...).
model RetainerEvent {
  id          String   @id @default(cuid())
  workspaceId String
  retainerId  String
  retainer    Retainer @relation(fields: [retainerId], references: [id], onDelete: Cascade)
  type        String
  message     String?
  metadata    String?
  actorUserId String?
  createdAt   DateTime @default(now())

  @@index([retainerId, createdAt])
}

model RetainerItem {
  id                String           @id @default(cuid())
  retainerId        String
  retainer          Retainer         @relation(fields: [retainerId], references: [id], onDelete: Cascade)
  
  serviceTemplateId String?
  serviceTemplate   ServiceTemplate? @relation(fields: [serviceTemplateId], references: [id], onDelete: SetNull)
  
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  title             String
  quantity          Int              @default(1)
  unitPrice         Decimal
  taxRate           Float?           @default(0)
  sacCode           String?
}

model MeteredUsage {
  id                String     @id @default(cuid())
  retainerId        String
  retainer          Retainer   @relation(fields: [retainerId], references: [id], onDelete: Cascade)
  
  description       String
  quantity          Decimal
  unitPrice         Decimal
  status            String     @default("PENDING") // PENDING, BILLED
  // Fraction (0.18). Null = use the retainer's own tax rate when billed.
  taxRate           Float?
  
  billedInInvoiceId String?
  billedInInvoice   Invoice?   @relation(fields: [billedInInvoiceId], references: [id], onDelete: SetNull)
  
  createdAt         DateTime   @default(now())
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("PENDING")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model WorkspaceTaxRegistration {
  id                 String          @id @default(cuid())
  workspaceId        String
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taxType            String
  jurisdictionCode   String
  registrationNumber String
  frequency          FilingFrequency
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  filingCalendarRules FilingCalendarRule[]
  taxObligations      TaxObligation[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, taxType, jurisdictionCode])
}

model FilingCalendarRule {
  id                String                   @id @default(cuid())
  workspaceId       String
  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taxRegistrationId String
  taxRegistration   WorkspaceTaxRegistration @relation(fields: [taxRegistrationId], references: [id], onDelete: Cascade)
  dueDayOfMonth     Int
  dueMonthOfYear    Int?
  lookaheadPeriods  Int                      @default(12)
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  taxObligations TaxObligation[]

  @@index([workspaceId, taxRegistrationId, isActive])
}

model TaxObligationPeriod {
  id           String              @id @default(cuid())
  workspaceId  String
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  obligationId String              @unique
  obligation   TaxObligation       @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  status       TaxObligationStatus @default(OPEN)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([workspaceId, periodStart, periodEnd])
}

model TaxObligation {
  id                String                   @id @default(cuid())
  workspaceId       String
  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taxRegistrationId String
  taxRegistration   WorkspaceTaxRegistration @relation(fields: [taxRegistrationId], references: [id], onDelete: Cascade)
  filingRuleId      String
  filingRule        FilingCalendarRule       @relation(fields: [filingRuleId], references: [id], onDelete: Cascade)
  dueDate           DateTime
  status            TaxObligationStatus      @default(OPEN)
  readyAt           DateTime?
  filedAt           DateTime?
  periodKey         String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  period          TaxObligationPeriod?
  complianceTasks ComplianceTask[]

  @@unique([workspaceId, taxRegistrationId, periodKey])
  @@index([workspaceId, status, dueDate])
}

model ComplianceTask {
  id           String               @id @default(cuid())
  workspaceId  String
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  obligationId String
  obligation   TaxObligation        @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  title        String
  dueDate      DateTime
  status       ComplianceTaskStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([workspaceId, obligationId, dueDate])
  @@index([workspaceId, status, dueDate])
}

model TaxRateOverride {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  scopeType String  @default("WORKSPACE") // "WORKSPACE" | "CLIENT" | "SERVICE"
  scopeRef  String?

  rate          Float
  effectiveFrom DateTime
  effectiveTo   DateTime?
  reason        String?

  isActive      Boolean   @default(true)
  deactivatedAt DateTime?

  createdByUserId String?
  createdByEmail  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs TaxRateOverrideAuditLog[]

  @@index([workspaceId, scopeType, isActive])
  @@index([workspaceId, effectiveFrom])
}

model TaxRateOverrideAuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  taxRateOverrideId String?
  taxRateOverride   TaxRateOverride? @relation(fields: [taxRateOverrideId], references: [id], onDelete: SetNull)

  action         String // "CREATE" | "UPDATE" | "DEACTIVATE"
  decisionSource String @default("OVERRIDE") // "AUTO" | "OVERRIDE" | "FALLBACK"

  scopeType String
  scopeRef  String?
  rate      Float?

  effectiveFrom DateTime?
  effectiveTo   DateTime?
  reason        String?

  previousValues Json?
  newValues      Json?

  actorUserId String?
  actorEmail  String?

  prevHash         String?
  entryHash        String?
  canonicalPayload Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action])
  @@index([workspaceId, scopeType])
}

model FileImportAuditLog {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  fileName      String?
  mimeType      String?
  fileSizeBytes Int?
  flow          String?
  status        String
  reason        String?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

// ==========================================
// 7. NOTIFICATION SYSTEM
// ==========================================

/// Stores Web Push API subscriptions (one per browser/device per user)
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String  @unique
  p256dh    String // Browser-generated public key
  auth      String // Browser-generated auth secret
  userAgent String? // Optional: identify device

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Persisted in-app notifications for the Bell UI / Sonner polling
model InAppNotification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Event type: INVOICE_GENERATED | CLIENT_ADDED | RENEWAL_ALERT | PAYMENT_REMINDER | TAX_ALERT | DEADLINE_ALERT | PROPOSAL_CREATED | SERVICE_CREATED
  eventType String
  title     String
  body      String
  /// Deep-link URL to navigate to on click
  actionUrl String?
  isRead    Boolean   @default(false)
  readAt    DateTime?

  /// Optional workspace context
  workspaceId String?

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([workspaceId])
}

// ==========================================
// 8. INVENTORY MANAGEMENT SYSTEM
// ==========================================

model Product {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sku         String
  name        String
  description String?
  category    String?
  unit        String  @default("pcs")

  // GST: HSN of the goods and the rate (percent) charged on them. Null rate = not set yet.
  hsnCode String?
  gstRate Float?

  // Cost & Valuation
  baselinePrice Decimal @default(0)
  costPrice     Decimal @default(0)

  // Stock Levels
  currentStock Int    @default(0)
  safetyStock  Int    @default(5)
  status       String @default("IN_STOCK") // "IN_STOCK", "LOW_STOCK", "OUT_OF_STOCK"

  barcode  String? // For zero-latency search
  imageUrl String? // Product image
  location String? // e.g., "Warehouse A", "Van 1"
  showInShop      Boolean @default(false)
  shopSortOrder   Int?
  shopDescription String?
  shopImageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements     InventoryMovement[]
  invoiceItems  InvoiceItem[]
  purchaseItems PurchaseOrderItem[]
  shopOrderItems ShopOrderItem[]
  retainerItems RetainerItem[]

  @@unique([sku, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, showInShop, currentStock])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal
  taxRate     Float   @default(0)
  sacCode     String?
  totalAmount Decimal

  @@index([invoiceId])
  @@index([productId])
}

model InventoryMovement {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     String // "IN" (Purchase, Return), "OUT" (Sale, Damage, Loss), "ADJ" (Manual Adjustment)
  quantity Int // Positive for IN, Negative for OUT/ADJ if reducing
  reason   String? // e.g., "Invoice #101 Payment", "Manual Sync", "Found behind shelf"

  referenceId String? // ID of Invoice or PO

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([productId])
  @@index([createdAt])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  poNumber String
  supplier String
  status   String @default("DRAFT") // "DRAFT", "SENT", "DELIVERED", "CANCELLED"

  // GST: supplier registration, carried onto the purchase bill when the PO is received.
  supplierGstin     String?
  supplierStateCode String?
  supplierInvoiceNo String?

  expectedDate        DateTime?
  paymentTermsDays    Int?
  expectedPaymentDate DateTime?
  receivedAt          DateTime?
  committedCashImpact Decimal?
  totalAmount         Decimal   @default(0)

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([poNumber, workspaceId])
  @@index([workspaceId])
}

model PurchaseOrderItem {
  id            String        @id @default(cuid())
  poId          String
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity      Int
  unitPrice     Decimal
  expectedTotal Decimal

  // GST: HSN and rate (percent) on this line; defaults come from the product master.
  hsnCode String?
  gstRate Float?
}

// ==========================================
// 9. E-STORE / SHOP
// ==========================================

model ShopOrder {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Buyer info (unauthenticated customer)
  buyerName  String
  buyerEmail String
  buyerPhone String?
  buyerNote  String? // Optional message / requirements from buyer
  // GST: where the goods go (state code) and the buyer's GSTIN, if they gave one.
  buyerStateCode String?
  buyerGstin     String?

  // Pricing snapshot (frozen at time of order)
  subtotal Decimal @default(0)
  taxTotal Decimal @default(0)
  amount   Decimal
  currency String  @default("INR")

  // Payment gateway references
  gateway               String? // "RAZORPAY" | "STRIPE"
  razorpayOrderId       String? @unique
  razorpayPaymentId     String?
  razorpaySignature     String?
  stripePaymentIntentId String? @unique
  stripeSessionId       String?

  // Status lifecycle
  status String @default("PENDING") // PENDING | PAID | FAILED | REFUNDED

  // Linked ERP invoice (auto-generated on payment success, nulled if invoice deleted)
  linkedInvoiceId String?
  linkedInvoice   Invoice? @relation("ShopOrderLinkedInvoice", fields: [linkedInvoiceId], references: [id], onDelete: SetNull)

  sourceProposalId    String?
  sourceProposal      Proposal?            @relation("ProposalToShopOrder", fields: [sourceProposalId], references: [id])
  proposalConversions ProposalConversion[]
  items               ShopOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([razorpayOrderId])
  @@index([stripePaymentIntentId])
}

model ShopOrderItem {
  id          String    @id @default(cuid())
  shopOrderId String
  shopOrder   ShopOrder @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal
  taxRate     Float   @default(0)
  lineTotal   Decimal
  lineTax     Decimal @default(0)
}

model UserPreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProposalConversion {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  conversionType ProposalConversionType

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  retainerId String?
  retainer   Retainer? @relation(fields: [retainerId], references: [id], onDelete: SetNull)

  shopOrderId String?
  shopOrder   ShopOrder? @relation(fields: [shopOrderId], references: [id], onDelete: SetNull)

  convertedAt       DateTime @default(now())
  convertedByUserId String?

  @@index([workspaceId, proposalId])
  @@index([conversionType])
}

model BillingMilestone {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  title       String
  description String?
  amount      Decimal
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING, INVOICED, PARTIALLY_PAID, PAID

  // When invoiced, it links to the actual standard invoice
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, proposalId])
}

model HelpFeedback {
  id String @id @default(cuid())

  /// Public Help Center article slug (/help/[slug])
  docSlug String

  /// Whether the article solved the user's need
  helpful Boolean

  /// Optional free-form feedback
  comment String?

  /// Optional context for routing/diagnostics
  currentRoute String?
  userAgent    String?

  /// Workspace / user context (if provided)
  workspaceId String?
  userId      String?

  createdAt DateTime @default(now())

  @@index([docSlug, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// ==========================================
// RBAC AUDIT LOG
// ==========================================

/**
 * RbacAuditLog — structured RBAC-specific event table.
 * Dual-write strategy: every RBAC event writes to BOTH this table AND AppActivityLog.
 * - RbacAuditLog → powers the "Access Activity" UI tab with structured, filterable data
 * - AppActivityLog → unified compliance/audit trail for all app events
 * Both writes happen through logRbacEvent() in lib/rbac.ts (single write path).
 * This table is NEVER written to directly — always via logRbacEvent().
 * Event types:
 * invite_sent, invite_accepted, invite_cancelled,
 * role_changed, member_removed, member_deactivated, member_reactivated,
 * seat_limit_hit, rbac_access_denied, owner_safeguard_blocked
 */
model RbacAuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The type of RBAC event. Stored as String for forward compatibility.
  eventType String

  actorUserId  String?
  actorEmail   String?
  targetUserId String?
  targetEmail  String?

  /// For role_changed events: the role before the change.
  previousRole String?

  /// For role_changed / invite_sent events: the new or invited role.
  newRole String?

  /// Additional structured metadata (e.g., denial reason, seat count at time of event).
  metadata Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, eventType, createdAt(sort: Desc)])
  @@index([workspaceId, actorUserId])
  @@index([workspaceId, targetUserId])
}


model MailBillingServer {
