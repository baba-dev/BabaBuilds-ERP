// ==========================================
// 10. OPTIONAL WORKSPACE MODULES
// ==========================================

/**
 * WorkspaceModule — Registry for optional ERP modules.
 * Each workspace can independently enable/disable optional modules.
 * Disabling a module hides it from navigation, dashboard, and routes
 * but preserves all underlying data (non-destructive).
 * Current modules: WORKFORCE
 * Future modules: PAYROLL, TIME_TRACKING, ASSETS
 */
model WorkspaceModule {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Module identifier: "WORKFORCE" | "PAYROLL" | etc.
  moduleKey String

  isEnabled Boolean @default(true)

  /// Module-specific configuration (JSON)
  configJson Json?

  enabledAt        DateTime  @default(now())
  disabledAt       DateTime?
  enabledByUserId  String?
  disabledByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, moduleKey])
  @@index([workspaceId, isEnabled])
  @@index([workspaceId, moduleKey])
}

model ImportRun {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  entityKey String
  fileName  String
  sourceMode String
  executionMode String?
  aiUsed    Boolean @default(false)
  status    String  @default("PREVIEW_READY")

  parsedCount   Int @default(0)
  importedCount Int @default(0)
  updatedCount  Int @default(0)
  skippedCount  Int @default(0)
  failedCount   Int @default(0)
  lastProcessedRow Int @default(0)

  inputJson   Json?
  previewJson Json?
  resultJson  Json?
  errorReportJson Json?
  sourceDigest String?
  idempotencyKey String?
  executionStartedAt DateTime?
  executionFinishedAt DateTime?

  initiatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, entityKey, status])
  @@unique([workspaceId, idempotencyKey])
}

// ==========================================
// 11. DOCUMENT VAULT (OPTIONAL MODULE)
// ==========================================

/**
 * Document — ERP-native document record.
 * Notes:
 * - Workspace-scoped
 * - Archive is organizational (non-destructive) and does not remove bytes
 * - Sensitivity/scope is enforced at the query/API layer (RBAC + personal rules)
 */
model Document {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title    String
  category String // Stored as String for forward compatibility
  scope    String // WORKSPACE_BUSINESS | ACCOUNTING | COMPLIANCE | PERSONAL_USER | GENERAL_ATTACHMENT (code enum)
  status   String @default("INBOX") // INBOX|PROCESSING|READY|LINKED|FAILED|ARCHIVED (code enum)

  isArchived       Boolean   @default(false)
  archivedAt       DateTime?
  archivedByUserId String?

  source           String? // upload_center|share_target|email (future)
  uploadedByUserId String?

  aiSummary        String?
  aiMeta           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files           DocumentFile[]
  links           DocumentLink[]
  taxLinks        TaxDocumentLink[]
  ocrJobs         DocumentOcrJob[]
  fields          DocumentExtractedField[]
  events          DocumentAuditEvent[]
  taxCreditEvents TaxCreditEvent[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([workspaceId, category, createdAt(sort: Desc)])
  @@index([workspaceId, scope, createdAt(sort: Desc)])
  @@index([workspaceId, isArchived, createdAt(sort: Desc)])
}

/**
 * DocumentFile — concrete stored bytes (supports versioning).
 * storedPath is a private serving route path like /documents/<workspaceId>/...
 */
model DocumentFile {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  isCurrent Boolean @default(true)

  mimeType     String
  originalName String
  storedPath   String
  sha256       String?
  byteSize     Int

  pageCount   Int?
  imageWidth  Int?
  imageHeight Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ocrJobs DocumentOcrJob[]
  fields  DocumentExtractedField[]
  events  DocumentAuditEvent[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, documentId])
  @@index([workspaceId, storedPath])
  @@index([documentId, isCurrent])
}

/**
 * DocumentOcrJob — async OCR/parsing job.
 */
model DocumentOcrJob {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  documentFileId String
  documentFile   DocumentFile @relation(fields: [documentFileId], references: [id], onDelete: Cascade)

  kind     String @default("GENERIC") // RECEIPT|INVOICE|STATEMENT|TAX|GENERIC
  status   String @default("QUEUED") // QUEUED|RUNNING|SUCCEEDED|FAILED
  provider String // Explicit registered provider key; no placeholder/default is permitted.

  attemptCount Int     @default(0)
  errorCode    String?
  errorMessage String?

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status, queuedAt(sort: Desc)])
  @@index([workspaceId, documentId])
  @@index([workspaceId, documentFileId])
}

/**
 * DocumentExtractedField — OCR-suggested or user-corrected fields.
 * Multiple revisions are represented as separate rows; the UI picks the latest/approved row per fieldKey.
 */
model DocumentExtractedField {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  documentFileId String
  documentFile   DocumentFile @relation(fields: [documentFileId], references: [id], onDelete: Cascade)

  fieldKey    String // vendorName|totalAmount|taxAmount|invoiceNumber|dueDate|statementPeriodStart|...
  valueText   String?
  valueNumber Float?
  valueDate   DateTime?
  confidence  Float?

  source           String  @default("OCR") // OCR|USER
  isApproved       Boolean @default(false)
  approvedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, documentId, fieldKey, createdAt(sort: Desc)])
  @@index([workspaceId, documentFileId])
}

/**
 * DocumentLink — polymorphic link from Document to ERP records.
 */
model DocumentLink {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  targetType String // EXPENSE|INVOICE|BANK_TRANSACTION|CLIENT|PROPOSAL|RETAINER|SERVICE_ORDER|PURCHASE_ORDER|...
  targetId   String
  relation   String @default("ATTACHMENT") // ATTACHMENT|EVIDENCE|SOURCE_DOC

  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, targetType, targetId])
  @@index([workspaceId, targetType, targetId])
  @@index([workspaceId, documentId])
}

/**
 * TaxDocumentLink — scoped link from Document vault records to tax compliance entities.
 */
model TaxDocumentLink {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  entityType String // RETURN_ACKNOWLEDGMENT | WITHHOLDING_CERTIFICATE | TAX_PAYMENT_PROOF
  entityKey  String // return period, certificate number, challan/proof id, etc.
  relation   String @default("EVIDENCE") // ACKNOWLEDGMENT | CERTIFICATE | PROOF | EVIDENCE

  notes           String?
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, documentId, entityType, entityKey])
  @@index([workspaceId, entityType, entityKey, createdAt(sort: Desc)])
  @@index([workspaceId, documentId, createdAt(sort: Desc)])
}

model TaxImportBatch {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  templateType String // WITHHOLDING_CERTIFICATES | FOREIGN_TAX_PAID | PRIOR_PERIOD_BALANCES
  sourceName   String?
  status       String  @default("COMPLETED") // COMPLETED | COMPLETED_WITH_ERRORS | FAILED

  submittedByUserId String?
  rowCount          Int     @default(0)
  successCount      Int     @default(0)
  warningCount      Int     @default(0)
  errorCount        Int     @default(0)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows TaxImportRow[]

  @@index([workspaceId, templateType, createdAt(sort: Desc)])
  @@index([workspaceId, status, createdAt(sort: Desc)])
}

model TaxImportRow {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  batchId String
  batch   TaxImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  rowNumber Int
  status    String // SUCCESS | WARNING | ERROR
  code      String? // VALIDATION_* | PARSE_* | BUSINESS_*
  message   String?
  fieldName String?

  rawData        Json?
  normalizedData Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, batchId, rowNumber])
  @@index([workspaceId, status, createdAt(sort: Desc)])
}

/**
 * WorkspaceDocumentStorage — cached totals for quota checks.
 * bytesUsedTotal includes archived. bytesUsedActive excludes archived (optional UX metric).
 */
model WorkspaceDocumentStorage {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  bytesUsedTotal  BigInt @default(0)
  bytesUsedActive BigInt @default(0)

  updatedAt DateTime @updatedAt
}

/**
 * DocumentAuditEvent — document-specific trust and audit trail.
 */
model DocumentAuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  documentFileId String?
  documentFile   DocumentFile? @relation(fields: [documentFileId], references: [id], onDelete: SetNull)

  eventType   String
  actorUserId String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, eventType, createdAt(sort: Desc)])
  @@index([workspaceId, documentId])
}

// ==========================================
// 12. WORKFORCE MODULE
// ==========================================

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  HOLIDAY
  REMOTE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollInputMode {
  STANDALONE
  WORKFORCE_LINKED
}

enum PayComponentCategory {
  BASE_SALARY
  ALLOWANCE
  VARIABLE_PAY
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum PayrollPeriodStatus {
  OPEN
  PROCESSING
  CLOSED
}

enum PayrollRunStatus {
  DRAFT
  REVIEW
  APPROVED
  POSTED
}

enum PayrollPostingStatus {
  PENDING
  POSTED
  FAILED
}

model Department {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  description String?
  headId      String? // Optional: Employee ID of department head

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Designation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title String
  level Int? // Seniority level for hierarchy (1 = entry, 5 = senior)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@unique([workspaceId, title])
  @@index([workspaceId])
}

/**
 * Employee — Core workforce entity.
 * userId is optional: if set, this employee has a workspace user account
 * and can self-service their own attendance/leave.
 * If null, the employee is HR-managed only (contractors, external staff).
 */
model Employee {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Optional link to workspace user for self-service
  userId String? // links to User.id

  // Core identity
  firstName String
  lastName  String
  email     String?
  phone     String?
  avatarUrl String?

  // Employment details
  employeeCode String? // e.g., "EMP-001"
  status       EmploymentStatus @default(ACTIVE)
  joinDate     DateTime?
  exitDate     DateTime?
  location     String?

  // Organizational structure
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  managerId     String? // Self-referential: another Employee.id
  manager       Employee?  @relation("EmployeeReports", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Employee[] @relation("EmployeeReports")

  // Emergency contact
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]

  @@unique([workspaceId, employeeCode])
  @@index([workspaceId, status])
  @@index([workspaceId, departmentId])
  @@index([workspaceId, managerId])
  @@index([userId])
}

model AttendanceRecord {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date   DateTime // Date of attendance (day-level)
  status AttendanceStatus @default(PRESENT)

  checkInAt  DateTime?
  checkOutAt DateTime?
  notes      String?

  /// Whether this record was entered by the employee (self) or by HR/manager
  isManagerEntered Boolean @default(false)
  managedByUserId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([workspaceId, date])
  @@index([workspaceId, employeeId, date])
  @@index([workspaceId, status])
}

model LeaveType {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String // "Annual Leave", "Sick Leave", "Casual Leave"
  code        String // "AL", "SL", "CL"
  description String?
  color       String  @default("indigo") // Tailwind color name for calendar dots
  defaultDays Int     @default(0) // Default annual entitlement
  isActive    Boolean @default(true)
  isPaid      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@unique([workspaceId, code])
  @@index([workspaceId, isActive])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  startDate DateTime
  endDate   DateTime
  days      Float    @default(1) // Supports 0.5 for half-day
  reason    String?

  status LeaveRequestStatus @default(PENDING)

  approvedByUserId String?
  approvedAt       DateTime?
  rejectionReason  String?

  /// Task record ID for approval queue integration
  taskId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, employeeId, status])
  @@index([workspaceId, startDate, endDate])
  @@index([workspaceId, status])
  @@index([workspaceId, leaveTypeId])
}

model LeaveBalance {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  year      Int // e.g., 2026
  entitled  Float @default(0)
  used      Float @default(0)
  pending   Float @default(0) // Submitted but not yet approved
  remaining Float @default(0) // Computed: entitled - used - pending

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([workspaceId, year])
  @@index([workspaceId, employeeId])
}

/**
 * PayrollPeriod — payroll window scoped per workspace.
 * Locked metadata allows preventing further mutations after close.
 */
model PayrollPeriod {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  status    PayrollPeriodStatus @default(OPEN)

  lockedAt       DateTime?
  lockedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs PayrollRun[]

  @@unique([workspaceId, startDate, endDate])
  @@index([workspaceId, status, startDate, endDate])
}

/**
 * PayrollRun — immutable run/version generated for a period.
 */
model PayrollRun {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  periodId String
  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  version Int
  status  PayrollRunStatus @default(DRAFT)

  totalEarnings      Decimal @default(0)
  totalDeductions    Decimal @default(0)
  totalEmployerCosts Decimal @default(0)
  totalNetPay        Decimal @default(0)

  generatedByUserId String?
  generatedAt       DateTime  @default(now())
  approvedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeSnapshots PayrollEmployeeSnapshot[]
  lineItems         PayrollLineItem[]
  posting           PayrollPosting?

  @@unique([periodId, version])
  @@index([workspaceId, periodId, status])
  @@index([workspaceId, status, generatedAt(sort: Desc)])
}

/**
 * PayrollEmployeeSnapshot — immutable employee + compensation truth at run time.
 * This decouples payroll history from later edits to Employee profile records.
 */
model PayrollEmployeeSnapshot {
  id String @id @default(cuid())

  runId String
  run   PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  // Source employee identifier kept as value (not relation) for immutability
  employeeId   String
  employeeCode String?
  firstName    String
  lastName     String
  email        String?

  departmentName String?
  designation    String?
  location       String?
  joinDate       DateTime?

  baseSalary       Decimal  @default(0)
  hourlyRate       Decimal?
  paymentFrequency String? // MONTHLY | BIWEEKLY | WEEKLY | CONTRACT
  compensationMeta Json?

  createdAt DateTime @default(now())

  lineItems PayrollLineItem[]

  @@unique([runId, employeeId])
  @@index([runId, employeeCode])
}

/**
 * PayrollLineItem — employee-level amounts for a run.
 */
model PayrollLineItem {
  id String @id @default(cuid())

  runId String
  run   PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  employeeSnapshotId String
  employeeSnapshot   PayrollEmployeeSnapshot @relation(fields: [employeeSnapshotId], references: [id], onDelete: Cascade)

  earnings      Decimal @default(0)
  deductions    Decimal @default(0)
  employerCosts Decimal @default(0)
  netPay        Decimal @default(0)

  currency       String @default("INR")
  breakdownJson  Json?
  calculationLog Json?

  createdAt DateTime @default(now())

  allocations PayrollCostAllocation[]

  @@unique([runId, employeeSnapshotId])
  @@index([runId, netPay])
}

/**
 * PayrollCostAllocation — split payroll cost by org dimensions.
 */
model PayrollCostAllocation {
  id String @id @default(cuid())

  lineItemId String
  lineItem   PayrollLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)

  departmentCode String?
  projectCode    String?
  costCenterCode String?

  allocationPercent Decimal @default(100)
  allocatedAmount   Decimal @default(0)
  metadata          Json?

  createdAt DateTime @default(now())

  @@index([lineItemId])
  @@index([departmentCode, projectCode, costCenterCode])
}

/**
 * PayrollPosting — accounting posting artifact for a payroll run.
 */
model PayrollPosting {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  runId String     @unique
  run   PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  postingStatus  PayrollPostingStatus @default(PENDING)
  idempotencyKey String

  journalReference         String?
  accountingTransactionId  String?
  accountingTransactionRef String?

  postedAt     DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, postingStatus, createdAt(sort: Desc)])
}

model WorkforceHoliday {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  date        DateTime
  isRecurring Boolean  @default(true) // true = repeats every year on same date
  year        Int? // null if isRecurring, else specific year

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, date])
  @@index([workspaceId, year])
}

model WorkSchedule {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// JSON array of working days: ["MON","TUE","WED","THU","FRI"]
  workingDays   String @default("[\"MON\",\"TUE\",\"WED\",\"THU\",\"FRI\"]")
  workStartTime String @default("09:00")
  workEndTime   String @default("18:00")
  timeZone      String @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollSettings {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  inputMode PayrollInputMode @default(STANDALONE)

  statutoryRulesJson        Json?
  paymentScheduleJson       Json?
  defaultCostAllocationJson Json?
  standaloneConfigJson      Json?
  workforceLinkedConfigJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollPayComponent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name     String
  code     String
  category PayComponentCategory

  isTaxable Boolean @default(true)
  isActive  Boolean @default(true)

  metadataJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId, category])
}

/**
 * One-time server-side claim for signed AI mutation confirmations.
 * The signed token is never stored; only its random nonce and binding are kept.
 */
model AiToolConfirmationNonce {
  nonce       String   @id
  userId      String
  workspaceId String
  toolName    String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([workspaceId, userId, expiresAt])
  @@index([expiresAt])
}

model SystemErrorLog {
  id          String   @id @default(cuid())
  errorType   String   // e.g. "TypeError", "PrismaClientKnownRequestError"
  message     String
  stackTrace  String?
  sourceFile  String?
  route       String?
  method      String?
  userId      String?
  workspaceId String?
  status      ErrorStatus @default(UNRESOLVED)
  environment String      @default("development")
  metadata    Json?

  // AI Diagnostics
  aiDiagnosis    String? // The explanation
  aiSuggestedFix String? // Proposed fix
  aiConfidence   Int?    // 0-100
  aiUserFriendlyMessage String? // What we told the user
  analyzedAt     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  remediation SystemRemediation?
}

enum ErrorStatus {
  UNRESOLVED
  ANALYZING
  RESOLVED
  IGNORED
}

model SystemRemediation {
  id            String   @id @default(cuid())
  errorLogId    String   @unique
  errorLog      SystemErrorLog @relation(fields: [errorLogId], references: [id], onDelete: Cascade)
  
  actionType    RemediationType
  content       String          
  description   String          
  
  status        RemediationStatus @default(PENDING_APPROVAL)
  executedAt    DateTime?
  executedBy    String?         
  executionLog  String?         

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum RemediationType {
  CODE_PATCH
  DATA_SCRIPT
  SYSTEM_RESTART
  SECURITY_BAN
}

enum RemediationStatus {
  PENDING_APPROVAL
  APPROVED
  EXECUTING
  SUCCESS
  FAILED
}


/// A GST return the workspace has recorded (filed, or with a notified due-date extension / manual inputs).
/// Return periods themselves are derived from the registration settings; a row exists only once there is state to keep.
model GstReturn {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  returnType String // GSTR1 | IFF | GSTR3B | CMP08 | GSTR4 | GSTR9 | GSTR9C
  periodKey  String // "2026-04" (month), "2026-Q1" (quarter of the FY, Apr-Jun = Q1) or "2025-26" (annual)
  status     String @default("OPEN") // OPEN | FILED

  extendedDueDate DateTime? // a notified extension, overrides the statutory date
  filedAt         DateTime?
  arn             String?
  filedByUserId   String?
  isNil           Boolean   @default(false)
  lateFeePaid     Decimal   @default(0)
  interestPaid    Decimal   @default(0)
  notes           String?

  // Frozen figures at the time of filing + manual inputs (GSTR-9 tables 10-16 etc.)
  inputsJson   Json?
  snapshotJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, returnType, periodKey])
  @@index([workspaceId, status])
}

/// Manual ledger movements that do not come from an invoice or a bill: opening ITC balance, rule 42/43 reversals, etc.
model GstAdjustment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  periodKey String // month "2026-04"
  kind      String // ITC_OPENING | ITC_REVERSAL_RULE_38 | ITC_REVERSAL_RULE_42_43 | ITC_REVERSAL_OTHER | ITC_REVERSED_CLAIMED_AGAIN | LIABILITY_ADJUSTMENT | CASH_PAID
  igst      Decimal @default(0)
  cgst      Decimal @default(0)
  sgst      Decimal @default(0)
  cess      Decimal @default(0)
  notes     String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([workspaceId, periodKey])
}

/// A supplier invoice as reported in the portal's GSTR-2B, kept to reconcile against recorded purchases.
model Gstr2bEntry {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  periodKey     String // return period of the 2B ("2026-04")
  supplierGstin String
  supplierName  String?
  invoiceNumber String
  invoiceDate   DateTime?
  taxableValue  Decimal  @default(0)
  igst          Decimal  @default(0)
  cgst          Decimal  @default(0)
  sgst          Decimal  @default(0)
  cess          Decimal  @default(0)
  itcAvailable  Boolean  @default(true)
  reverseCharge Boolean  @default(false)

  createdAt DateTime @default(now())

  @@unique([workspaceId, periodKey, supplierGstin, invoiceNumber])
  @@index([workspaceId, periodKey])
}


/// A debit note raised to increase the value or tax of an earlier invoice (GSTR-1 table 9B).
model GstDebitNote {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  noteNumber    String
  issuedAt      DateTime
  invoiceNumber String? // invoice it relates to
  invoiceDate   DateTime?
  recipientName String
  recipientGstin String?
  pos           String // place of supply: state code, or "96" for exports
  rate          Float
  taxable       Decimal @default(0)
  igst          Decimal @default(0)
  cgst          Decimal @default(0)
  sgst          Decimal @default(0)
  cess          Decimal @default(0)
  reason        String

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@unique([workspaceId, noteNumber])
  @@index([workspaceId, issuedAt])
}

/// A correction to an invoice or note already reported in an earlier return (GSTR-1 tables 9A / 10); stored as original vs revised.
model GstAmendment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  periodKey         String // return period the amendment is reported in
  originalPeriodKey String
  originalNumber    String
  originalDate      DateTime
  recipientName     String?
  recipientGstin    String? // set => B2B amendment (9A), empty => B2C small amendment (10)
  pos               String
  rate              Float

  originalTaxable Decimal @default(0)
  originalIgst    Decimal @default(0)
  originalCgst    Decimal @default(0)
  originalSgst    Decimal @default(0)
  revisedTaxable  Decimal @default(0)
  revisedIgst     Decimal @default(0)
  revisedCgst     Decimal @default(0)
  revisedSgst     Decimal @default(0)
  reason          String

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([workspaceId, periodKey])
}

/// Money received before the invoice is raised; GST is payable in the month of receipt (GSTR-1 table 11).
model GstAdvance {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  receivedAt     DateTime
  party          String
  recipientGstin String?
  pos            String
  rate           Float
  amount         Decimal // received, GST included
  taxable        Decimal @default(0)
  igst           Decimal @default(0)
  cgst           Decimal @default(0)
  sgst           Decimal @default(0)
  adjustedAt     DateTime? // when an invoice was raised against it
  adjustedInvoice String?
  notes          String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([workspaceId, receivedAt])
}

/// Review thread on a return (accountant <-> owner).
model GstReturnComment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  returnType   String
  periodKey    String
  authorUserId String
  authorName   String?
  body         String
  createdAt    DateTime @default(now())

  @@index([workspaceId, returnType, periodKey])
}

/// De-duplicates GST reminder sends per workspace.
model GstReminderLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  key     String // e.g. "GSTR3B:2026-09:T-3" or "DIGEST:2026-W45"
  channel String // EMAIL | INAPP
  sentAt  DateTime @default(now())

  @@unique([workspaceId, key, channel])
}


// ==========================================
// CA COMPLIANCE
// ==========================================

/// A person's record against one obligation (status, filing reference, extension, sign-off). Which obligations exist and
/// when they fall due is derived from the rules in lib/ca, so only what someone set is stored here.
model CaComplianceItem {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  kind      String // ADVANCE_TAX | TDS_DEPOSIT | TDS_RETURN | ITR | TAX_AUDIT | PF | ESI | ROC_* | YEAR_CLOSE ...
  periodKey String // 2026-06 | 26-27-Q1 | 26-27
  fy        String // 26-27

  status String @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | READY | FILED | NOT_APPLICABLE

  ownerUserId String?
  filedAt     DateTime?
  reference   String? // ARN / acknowledgement number / challan
  notes       String?
  /// Extended due date notified by the government, when different from the standard one.
  dueOverride DateTime?

  signedOffByUserId String?
  signedOffByName   String?
  signedOffAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, kind, periodKey])
  @@index([workspaceId, fy])
}

/// A document request or a query between the owner and their CA.
model CaRequest {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  fy     String
  kind   String // DOCUMENT | QUERY
  title  String
  status String @default("OPEN") // OPEN | ANSWERED | CLOSED

  /// What it is about: an obligation (itemKind + periodKey) or a record (linkType + linkId).
  itemKind  String?
  periodKey String?
  linkType  String? // INVOICE | EXPENSE | OTHER
  linkId    String?
  dueDate   DateTime?

  createdByUserId String
  createdByName   String
  closedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages CaRequestMessage[]

  @@index([workspaceId, fy, status])
}

model CaRequestMessage {
  id          String    @id @default(cuid())
  requestId   String
  request     CaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  workspaceId String

  authorUserId String
  authorName   String
  authorRole   String?
  body         String
  /// A document from the vault attached to the message.
  documentId   String?

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

/// People at a client: who gets invoices, who gets reminders, who to call.
model ClientContact {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name              String
  role              String?
  email             String?
  phone             String?
  isPrimary         Boolean  @default(false)
  receivesInvoices  Boolean  @default(true)
  receivesReminders Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([workspaceId, clientId])
}

/// Internal notes on a client (calls, agreements, context). Never shown to the client.
model ClientNote {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  authorUserId String?
  authorName   String
  body         String
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([workspaceId, clientId, createdAt(sort: Desc)])
}
