  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  entryType     String // TAX_TYPE | FILING_FREQUENCY | CORE_FORM | BASELINE_RATE | CALENDAR_RULE
  countryCode   String    @default("IN")
  code          String
  label         String?
  payloadJson   Json
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  sourceDocumentRef      Json?
  verificationLevel      String?
  reviewStatus           String?
  legalCertaintyRequired Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entryType, countryCode, code])
  @@index([workspaceId, entryType])
  @@index([countryCode, entryType])
}

model TaxPeriod {
