  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([taxReturnId, blockerCode])
  @@index([workspaceId, status, severity])
  @@index([workspaceId, taxReturnId])
  @@index([workspaceId, status, severity, updatedAt(sort: Desc)])
}

model InvoiceIdempotency {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  idempotencyKey String
  requestHash    String
  invoiceId      String?
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  responseBody   Json?
  status         String    @default("PENDING") // "PENDING" | "CONSUMED"
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, expiresAt])
}

model Expense {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  date        DateTime
  category    String
  vendor      String
  amount      Decimal
  description String?
  receiptUrl  String?
  createdAt   DateTime @default(now())

  withholdingRatePercent    Decimal?
  withholdingAmount         Decimal?
  withholdingDeductedAt     DateTime?
  withholdingDepositedAt    DateTime?
  withholdingDepositDueAt   DateTime?
  withholdingReminderSentAt DateTime?

  withholdingEvents WithholdingEvent[]

  @@index([date])
  @@index([category])
  @@index([workspaceId])
}

model WithholdingEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sourceType String // INVOICE_PAYMENT|EXPENSE_PAYMENT|MANUAL
  sourceId   String?
  invoiceId  String?
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  expenseId  String?
  expense    Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  counterpartyName String?
  sectionCode      String?

  grossAmount            Decimal
  withheldAmount         Decimal
  withholdingRatePercent Decimal?

  deductedAt     DateTime
  depositedAt    DateTime?
  depositDueAt   DateTime?
  reminderSentAt DateTime?

  returnPeriodKey String?
  notes           String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId, deductedAt])
  @@index([workspaceId, returnPeriodKey])
  @@index([workspaceId, sourceType, sourceId])
}

model TaxCreditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sourceType String // WITHHOLDING_CERTIFICATE|MANUAL|IMPORT
  sourceId   String?

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  creditType        String  @default("WITHHOLDING") // WITHHOLDING|ADVANCE_TAX|OTHER
  counterpartyName  String?
  certificateNumber String?

  grossAmount    Decimal?
  creditedAmount Decimal
  withheldAmount Decimal?

  certificateIssuedAt DateTime?
  periodStart         DateTime?
  periodEnd           DateTime?
  returnPeriodKey     String?

  status String  @default("POSTED") // POSTED|REVERSED|PENDING_REVIEW
  notes  String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ledgerEntries TaxCreditLedgerEntry[]

  @@index([workspaceId, returnPeriodKey])
  @@index([workspaceId, periodStart, periodEnd])
  @@index([workspaceId, documentId])
}

model TaxCreditLedgerEntry {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  taxCreditEventId String
  taxCreditEvent   TaxCreditEvent @relation(fields: [taxCreditEventId], references: [id], onDelete: Cascade)

  entryType       String // CREDIT|REVERSAL|ADJUSTMENT
  amount          Decimal
  entryDate       DateTime
  returnPeriodKey String?
  notes           String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([workspaceId, entryDate])
  @@index([workspaceId, returnPeriodKey])
  @@index([workspaceId, taxCreditEventId])
}

model TaxReturnPeriod {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  periodKey   String
  periodStart DateTime
  periodEnd   DateTime

  dueDate DateTime
  filedAt DateTime?

  expectedWithheldAmount   Decimal @default(0)
  reconciledWithheldAmount Decimal @default(0)

  status String  @default("OPEN") // OPEN|FILED|OVERDUE
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, periodKey])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, periodStart, periodEnd])
}

model BankTransaction {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  accountId String?
  account   BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  date                     DateTime
  description              String
  amount                   Decimal // Positive for deposits, negative for withdrawals
  referenceId              String?
  transactionType          String?
  isInternalTransfer       Boolean  @default(false)
  reconciliationConfidence Float?
  category                 String?

  // Reconciliation state
  isReconciled     Boolean @default(false)
  matchedInvoiceId String?
  matchedExpenseId String?

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([accountId])
  @@index([date])
}

model BankAccount {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name                String
  bankName            String?
  maskedAccountNumber String?
  currency            String  @default("INR")

  openingBalance     Decimal  @default(0)
  openingBalanceDate DateTime @default(now())

  // Optional cached value; source of truth is openingBalance + transactions.
  currentBalance Decimal?

  transactions BankTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model CashForecastSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  generatedAt DateTime                @default(now())
  horizonType CashForecastHorizonType
  scenarioTag CashForecastScenarioTag @default(BASE)

  startDate DateTime
  endDate   DateTime

  openingCash            Decimal @default(0)
  closingCash            Decimal @default(0)
  totalProjectedInflows  Decimal @default(0)
  totalProjectedOutflows Decimal @default(0)

  confidenceScore Float?
  assumptionsJson Json?
  generatedBy     CashForecastGeneratedBy @default(SYSTEM)

  createdAt DateTime @default(now())

  periods CashForecastPeriod[]

  @@index([workspaceId, horizonType, scenarioTag, generatedAt(sort: Desc)])
  @@index([workspaceId, startDate, endDate])
}

model CashForecastPeriod {
  id         String               @id @default(cuid())
  snapshotId String
  snapshot   CashForecastSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  bucketLabel String

  openingCash Decimal @default(0)

  actualInflows     Decimal @default(0)
  projectedInflows  Decimal @default(0)
  actualOutflows    Decimal @default(0)
  projectedOutflows Decimal @default(0)

  closingCash Decimal @default(0)

  riskLevel                 CashForecastRiskLevel @default(LOW)
  varianceFromPriorForecast Decimal?
  notesJson                 Json?

  lineItems CashForecastLineItem[]

  @@index([snapshotId, periodStart])
  @@index([snapshotId, riskLevel])
}

model CashForecastLineItem {
  id       String             @id @default(cuid())
  periodId String
  period   CashForecastPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  direction      CashForecastDirection
  sourceType     CashForecastSourceType
  sourceId       String?
  amount         Decimal
  expectedDate   DateTime
  confidence     Float?
  scenarioTag    CashForecastScenarioTag    @default(BASE)
  classification CashForecastClassification
  title          String
  metadataJson   Json?
  explanation    String?

  createdAt DateTime @default(now())

  @@index([periodId, expectedDate])
  @@index([sourceType, sourceId])
  @@index([classification])
}

model CashForecastAssumption {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  key           String
  valueJson     Json
  effectiveFrom DateTime?
  isActive      Boolean   @default(true)
  updatedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, key, isActive])
  @@index([workspaceId, isActive, key])
}

model CashForecastManualAdjustment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  date      DateTime
  amount    Decimal
  direction CashForecastDirection
  reason    String
  category  String?
  createdBy String?

  createdAt DateTime @default(now())

  @@index([workspaceId, date])
  @@index([workspaceId, direction])
}

model CashForecastLineItemPlan {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  horizonType CashForecastHorizonType
  scenarioTag CashForecastScenarioTag @default(BASE)

  // Stable identifier for a forecast driver across snapshots.
  // Typically derived from {sourceType, sourceId} (fallback to title hash).
  planKey String

  status String  @default("open") // "open" | "deferred" | "resolved"
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, horizonType, scenarioTag, planKey])
  @@index([workspaceId, horizonType, scenarioTag])
}

model CashForecastAlertPreference {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Keep this scoped and minimal in v1. Later: quiet hours, channels, per-alert thresholds.
  criticalEnabled Boolean @default(true)
  warningEnabled  Boolean @default(true)
  infoEnabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId])
}

model Investment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  date      DateTime
  category  String
  assetName String
  amount    Decimal
  createdAt DateTime @default(now())

  @@index([date])
  @@index([category])
  @@index([workspaceId])
}

// ==========================================
// 4. GLOBAL COMPLIANCE DICTIONARIES (Read-Only)
// ==========================================

model NICCode {
  id          String  @id @default(cuid())
  code        String  @unique // e.g., "62012"
  description String // e.g., "Web-page designing"
  countryCode String  @default("IN") // "IN" for India, "US", "GB", etc.
  isCustom    Boolean @default(false)

  services ServiceTemplate[]
}

model SACCode {
  id          String  @id @default(cuid())
  code        String  @unique // e.g., "998313"
  description String // e.g., "IT Consulting Services"
  igstRate    Float   @default(18.0) // Default GST rate
  countryCode String  @default("IN")
  isCustom    Boolean @default(false)

  services ServiceTemplate[]
}

// ==========================================
// 5. PROPOSALS & SERVICE CATALOG (Workspace-Scoped)
// ==========================================

// The user's saved list of services (e.g., "Monthly SEO Retainer")
model ServiceTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name         String
  description  String? // Short description (for invoices/proposals)
  defaultPrice Decimal @default(0)

  // E-STORE FIELDS
  longDescription String? // Rich HTML/markdown from Tiptap — shown on shop page
  imageUrl        String? // Hero image path e.g. /uploads/service-hero/xxx.webp
  showInShop      Boolean @default(false) // Publishes service to workspace public shop

  // Relational Links to the Global Dictionaries
  nicCodeId String?
  nicCode   NICCode? @relation(fields: [nicCodeId], references: [id])

  sacCodeId String?
  sacCode   SACCode? @relation(fields: [sacCodeId], references: [id])

  proposalItems ProposalItem[]
  serviceOrders ServiceOrder[]

  @@index([workspaceId])
  @@index([workspaceId, showInShop])
}

model Proposal {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  proposalNo String // e.g., "EST-2024-001"
  title      String // e.g., "Q3 Marketing Campaign"
  status     String @default("DRAFT") // DRAFT, SENT, VIEWED, ACCEPTED, DECLINED, INVOICED

  dateCreated DateTime @default(now())
  validUntil  DateTime

  // The Public Link token (e.g., bababuilds.com/p/abc123xyz)
  publicToken String @unique @default(cuid())

  // E-Signature & Lifecycle Data
  acceptedAt     DateTime?
  clientIp       String?
  acceptedByName String?

  sentAt           DateTime?
  sentByUserId     String?
  firstViewedAt    DateTime?
  lastViewedAt     DateTime?
  viewCount        Int       @default(0)
  declinedAt       DateTime?
  declineReason    String?
  firstConvertedAt DateTime?
  expiredAt        DateTime?

  items                  ProposalItem[]
  conversions            ProposalConversion[]
  billingMilestones      BillingMilestone[]
  generatedInvoices      Invoice[]            @relation("ProposalToInvoice")
  generatedRetainers     Retainer[]           @relation("ProposalToRetainer")
  generatedServiceOrders ServiceOrder[]       @relation("ProposalToServiceOrder")

  subtotal     Decimal
  estimatedTax Decimal @default(0)
  totalAmount  Decimal

  @@unique([proposalNo, workspaceId])
  @@index([workspaceId])
  @@index([publicToken])
}

model ProposalItem {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  serviceTemplateId String?
  serviceTemplate   ServiceTemplate? @relation(fields: [serviceTemplateId], references: [id], onDelete: SetNull)

  title       String // Copied from template so it can be edited per-proposal
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal
  total       Decimal
}

model Retainer {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // The Billing Details
  amount    Decimal
  frequency String  @default("MONTHLY") // "MONTHLY", "QUARTERLY", "ANNUALLY"
  status    String  @default("ACTIVE") // "ACTIVE", "PAUSED", "CANCELLED"

  // The Automation Engine
  nextBillingDate DateTime
  autoAppendMonth Boolean  @default(true) // The "Zero-Effort" Toggle

  // What exactly are we billing them for?
  serviceName String
  sacCode     String?
  taxRate     Float?

  sourceProposalId    String?
  sourceProposal      Proposal?            @relation("ProposalToRetainer", fields: [sourceProposalId], references: [id])
  proposalConversions ProposalConversion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("PENDING")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model WorkspaceTaxRegistration {
  id                 String          @id @default(cuid())
  workspaceId        String
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taxType            String
  jurisdictionCode   String
  registrationNumber String
  frequency          FilingFrequency
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  filingCalendarRules FilingCalendarRule[]
  taxObligations      TaxObligation[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, taxType, jurisdictionCode])
}

model FilingCalendarRule {
  id                String                   @id @default(cuid())
  workspaceId       String
  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taxRegistrationId String
  taxRegistration   WorkspaceTaxRegistration @relation(fields: [taxRegistrationId], references: [id], onDelete: Cascade)
  dueDayOfMonth     Int
  dueMonthOfYear    Int?
  lookaheadPeriods  Int                      @default(12)
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  taxObligations TaxObligation[]

  @@index([workspaceId, taxRegistrationId, isActive])
}

model TaxObligationPeriod {
  id           String              @id @default(cuid())
  workspaceId  String
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  obligationId String              @unique
  obligation   TaxObligation       @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  status       TaxObligationStatus @default(OPEN)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([workspaceId, periodStart, periodEnd])
}

model TaxObligation {
  id                String                   @id @default(cuid())
  workspaceId       String
  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taxRegistrationId String
  taxRegistration   WorkspaceTaxRegistration @relation(fields: [taxRegistrationId], references: [id], onDelete: Cascade)
  filingRuleId      String
  filingRule        FilingCalendarRule       @relation(fields: [filingRuleId], references: [id], onDelete: Cascade)
  dueDate           DateTime
  status            TaxObligationStatus      @default(OPEN)
  readyAt           DateTime?
  filedAt           DateTime?
  periodKey         String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  period          TaxObligationPeriod?
  complianceTasks ComplianceTask[]

  @@unique([workspaceId, taxRegistrationId, periodKey])
  @@index([workspaceId, status, dueDate])
}

model ComplianceTask {
  id           String               @id @default(cuid())
  workspaceId  String
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  obligationId String
  obligation   TaxObligation        @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  title        String
  dueDate      DateTime
  status       ComplianceTaskStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([workspaceId, obligationId, dueDate])
  @@index([workspaceId, status, dueDate])
}

model TaxRateOverride {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  scopeType String  @default("WORKSPACE") // "WORKSPACE" | "CLIENT" | "SERVICE"
  scopeRef  String?

  rate          Float
  effectiveFrom DateTime
  effectiveTo   DateTime?
  reason        String?

  isActive      Boolean   @default(true)
  deactivatedAt DateTime?

  createdByUserId String?
  createdByEmail  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs TaxRateOverrideAuditLog[]

  @@index([workspaceId, scopeType, isActive])
  @@index([workspaceId, effectiveFrom])
}

model TaxRateOverrideAuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  taxRateOverrideId String?
  taxRateOverride   TaxRateOverride? @relation(fields: [taxRateOverrideId], references: [id], onDelete: SetNull)

  action         String // "CREATE" | "UPDATE" | "DEACTIVATE"
  decisionSource String @default("OVERRIDE") // "AUTO" | "OVERRIDE" | "FALLBACK"

  scopeType String
  scopeRef  String?
  rate      Float?

  effectiveFrom DateTime?
  effectiveTo   DateTime?
  reason        String?

  previousValues Json?
  newValues      Json?

  actorUserId String?
  actorEmail  String?

  prevHash         String?
  entryHash        String?
  canonicalPayload Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action])
  @@index([workspaceId, scopeType])
}

model FileImportAuditLog {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  fileName      String?
  mimeType      String?
  fileSizeBytes Int?
  flow          String?
  status        String
  reason        String?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

// ==========================================
// 7. NOTIFICATION SYSTEM
// ==========================================

/// Stores Web Push API subscriptions (one per browser/device per user)
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String  @unique
  p256dh    String // Browser-generated public key
  auth      String // Browser-generated auth secret
  userAgent String? // Optional: identify device

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Persisted in-app notifications for the Bell UI / Sonner polling
model InAppNotification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Event type: INVOICE_GENERATED | CLIENT_ADDED | RENEWAL_ALERT | PAYMENT_REMINDER | TAX_ALERT | DEADLINE_ALERT | PROPOSAL_CREATED | SERVICE_CREATED
  eventType String
  title     String
  body      String
  /// Deep-link URL to navigate to on click
  actionUrl String?
  isRead    Boolean   @default(false)
  readAt    DateTime?

  /// Optional workspace context
  workspaceId String?

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([workspaceId])
}

// ==========================================
// 8. INVENTORY MANAGEMENT SYSTEM
// ==========================================

model Product {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sku         String
  name        String
  description String?
  category    String?
  unit        String  @default("pcs")

  // Cost & Valuation
  baselinePrice Decimal @default(0)
  costPrice     Decimal @default(0)

  // Stock Levels
  currentStock Int    @default(0)
  safetyStock  Int    @default(5)
  status       String @default("IN_STOCK") // "IN_STOCK", "LOW_STOCK", "OUT_OF_STOCK"

  barcode  String? // For zero-latency search
  imageUrl String? // Product image
  location String? // e.g., "Warehouse A", "Van 1"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements     InventoryMovement[]
  invoiceItems  InvoiceItem[]
  purchaseItems PurchaseOrderItem[]

  @@unique([sku, workspaceId])
  @@index([workspaceId])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal
  taxRate     Float   @default(0)
  totalAmount Decimal

  @@index([invoiceId])
  @@index([productId])
}

model InventoryMovement {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     String // "IN" (Purchase, Return), "OUT" (Sale, Damage, Loss), "ADJ" (Manual Adjustment)
  quantity Int // Positive for IN, Negative for OUT/ADJ if reducing
  reason   String? // e.g., "Invoice #101 Payment", "Manual Sync", "Found behind shelf"

  referenceId String? // ID of Invoice or PO

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([productId])
  @@index([createdAt])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  poNumber String
  supplier String
  status   String @default("DRAFT") // "DRAFT", "SENT", "DELIVERED", "CANCELLED"

  expectedDate        DateTime?
  paymentTermsDays    Int?
  expectedPaymentDate DateTime?
  receivedAt          DateTime?
  committedCashImpact Decimal?
  totalAmount         Decimal   @default(0)

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([poNumber, workspaceId])
  @@index([workspaceId])
}

model PurchaseOrderItem {
  id            String        @id @default(cuid())
  poId          String
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity      Int
  unitPrice     Decimal
  expectedTotal Decimal
}

// ==========================================
// 9. E-STORE / SHOP
// ==========================================

model ServiceOrder {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  serviceTemplateId String
  serviceTemplate   ServiceTemplate @relation(fields: [serviceTemplateId], references: [id], onDelete: Restrict)

  // Buyer info (unauthenticated customer)
  buyerName  String
  buyerEmail String
  buyerPhone String?
  buyerNote  String? // Optional message / requirements from buyer

  // Pricing snapshot (frozen at time of order)
  amount   Decimal
  currency String  @default("INR")

  // Payment gateway references
  gateway               String? // "RAZORPAY" | "STRIPE"
  razorpayOrderId       String? @unique
  razorpayPaymentId     String?
  razorpaySignature     String?
  stripePaymentIntentId String? @unique
  stripeSessionId       String?

  // Status lifecycle
  status String @default("PENDING") // PENDING | PAID | FAILED | REFUNDED

  // Linked ERP invoice (auto-generated on payment success, nulled if invoice deleted)
  linkedInvoiceId String?
  linkedInvoice   Invoice? @relation("ServiceOrderLinkedInvoice", fields: [linkedInvoiceId], references: [id], onDelete: SetNull)

  sourceProposalId    String?
  sourceProposal      Proposal?            @relation("ProposalToServiceOrder", fields: [sourceProposalId], references: [id])
  proposalConversions ProposalConversion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([razorpayOrderId])
  @@index([stripePaymentIntentId])
}

model UserPreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProposalConversion {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  conversionType ProposalConversionType

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  retainerId String?
  retainer   Retainer? @relation(fields: [retainerId], references: [id], onDelete: SetNull)

  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  convertedAt       DateTime @default(now())
  convertedByUserId String?

  @@index([workspaceId, proposalId])
  @@index([conversionType])
}

model BillingMilestone {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  title       String
  description String?
  amount      Decimal
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING, INVOICED, PARTIALLY_PAID, PAID

  // When invoiced, it links to the actual standard invoice
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, proposalId])
}

model HelpFeedback {
  id String @id @default(cuid())

  /// Public Help Center article slug (/help/[slug])
  docSlug String

  /// Whether the article solved the user's need
  helpful Boolean

  /// Optional free-form feedback
  comment String?

  /// Optional context for routing/diagnostics
  currentRoute String?
  userAgent    String?

  /// Workspace / user context (if provided)
  workspaceId String?
  userId      String?

  createdAt DateTime @default(now())

  @@index([docSlug, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// ==========================================
// RBAC AUDIT LOG
// ==========================================

/**
 * RbacAuditLog — structured RBAC-specific event table.
 * Dual-write strategy: every RBAC event writes to BOTH this table AND AppActivityLog.
 * - RbacAuditLog → powers the "Access Activity" UI tab with structured, filterable data
 * - AppActivityLog → unified compliance/audit trail for all app events
 * Both writes happen through logRbacEvent() in lib/rbac.ts (single write path).
 * This table is NEVER written to directly — always via logRbacEvent().
 * Event types:
 * invite_sent, invite_accepted, invite_cancelled,
 * role_changed, member_removed, member_deactivated, member_reactivated,
 * seat_limit_hit, rbac_access_denied, owner_safeguard_blocked
 */
model RbacAuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The type of RBAC event. Stored as String for forward compatibility.
  eventType String

  actorUserId  String?
  actorEmail   String?
  targetUserId String?
  targetEmail  String?

  /// For role_changed events: the role before the change.
  previousRole String?

  /// For role_changed / invite_sent events: the new or invited role.
  newRole String?

  /// Additional structured metadata (e.g., denial reason, seat count at time of event).
  metadata Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, eventType, createdAt(sort: Desc)])
  @@index([workspaceId, actorUserId])
  @@index([workspaceId, targetUserId])
}

// ==========================================
// 10. OPTIONAL WORKSPACE MODULES
// ==========================================

/**
 * WorkspaceModule — Registry for optional ERP modules.
 * Each workspace can independently enable/disable optional modules.
 * Disabling a module hides it from navigation, dashboard, and routes
 * but preserves all underlying data (non-destructive).
 * Current modules: WORKFORCE
 * Future modules: PAYROLL, TIME_TRACKING, ASSETS
 */
model WorkspaceModule {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Module identifier: "WORKFORCE" | "PAYROLL" | etc.
  moduleKey String

  isEnabled Boolean @default(true)

  /// Module-specific configuration (JSON)
  configJson Json?

  enabledAt        DateTime  @default(now())
  disabledAt       DateTime?
  enabledByUserId  String?
  disabledByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, moduleKey])
  @@index([workspaceId, isEnabled])
  @@index([workspaceId, moduleKey])
}

// ==========================================
// 11. DOCUMENT VAULT (OPTIONAL MODULE)
// ==========================================

/**
 * Document — ERP-native document record.
 * Notes:
 * - Workspace-scoped
 * - Archive is organizational (non-destructive) and does not remove bytes
 * - Sensitivity/scope is enforced at the query/API layer (RBAC + personal rules)
 */
model Document {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title    String
  category String // Stored as String for forward compatibility
  scope    String // WORKSPACE_BUSINESS | ACCOUNTING | COMPLIANCE | PERSONAL_USER | GENERAL_ATTACHMENT (code enum)
  status   String @default("INBOX") // INBOX|PROCESSING|READY|LINKED|FAILED|ARCHIVED (code enum)

  isArchived       Boolean   @default(false)
  archivedAt       DateTime?
  archivedByUserId String?

  source           String? // upload_center|share_target|email (future)
  uploadedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files           DocumentFile[]
  links           DocumentLink[]
  taxLinks        TaxDocumentLink[]
  ocrJobs         DocumentOcrJob[]
  fields          DocumentExtractedField[]
  events          DocumentAuditEvent[]
  taxCreditEvents TaxCreditEvent[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([workspaceId, category, createdAt(sort: Desc)])
  @@index([workspaceId, scope, createdAt(sort: Desc)])
  @@index([workspaceId, isArchived, createdAt(sort: Desc)])
}

/**
 * DocumentFile — concrete stored bytes (supports versioning).
 * storedPath is a private serving route path like /documents/<workspaceId>/...
 */
model DocumentFile {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  isCurrent Boolean @default(true)

  mimeType     String
  originalName String
  storedPath   String
  sha256       String?
  byteSize     Int

  pageCount   Int?
  imageWidth  Int?
  imageHeight Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ocrJobs DocumentOcrJob[]
  fields  DocumentExtractedField[]
  events  DocumentAuditEvent[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, documentId])
  @@index([workspaceId, storedPath])
  @@index([documentId, isCurrent])
}

/**
 * DocumentOcrJob — async OCR/parsing job.
 */
model DocumentOcrJob {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  documentFileId String
  documentFile   DocumentFile @relation(fields: [documentFileId], references: [id], onDelete: Cascade)

  kind     String @default("GENERIC") // RECEIPT|INVOICE|STATEMENT|TAX|GENERIC
  status   String @default("QUEUED") // QUEUED|RUNNING|SUCCEEDED|FAILED
  provider String @default("UNCONFIGURED") // LOCAL_TESSERACT|GOOGLE_VISION|AWS_TEXTRACT|...

  attemptCount Int     @default(0)
  errorCode    String?
  errorMessage String?

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status, queuedAt(sort: Desc)])
  @@index([workspaceId, documentId])
  @@index([workspaceId, documentFileId])
}

/**
 * DocumentExtractedField — OCR-suggested or user-corrected fields.
 * Multiple revisions are represented as separate rows; the UI picks the latest/approved row per fieldKey.
 */
model DocumentExtractedField {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  documentFileId String
  documentFile   DocumentFile @relation(fields: [documentFileId], references: [id], onDelete: Cascade)

  fieldKey    String // vendorName|totalAmount|taxAmount|invoiceNumber|dueDate|statementPeriodStart|...
  valueText   String?
  valueNumber Float?
  valueDate   DateTime?
  confidence  Float?

  source           String  @default("OCR") // OCR|USER
  isApproved       Boolean @default(false)
  approvedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, documentId, fieldKey, createdAt(sort: Desc)])
  @@index([workspaceId, documentFileId])
}

/**
 * DocumentLink — polymorphic link from Document to ERP records.
 */
model DocumentLink {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  targetType String // EXPENSE|INVOICE|BANK_TRANSACTION|CLIENT|PROPOSAL|RETAINER|SERVICE_ORDER|PURCHASE_ORDER|...
  targetId   String
  relation   String @default("ATTACHMENT") // ATTACHMENT|EVIDENCE|SOURCE_DOC

  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, targetType, targetId])
  @@index([workspaceId, targetType, targetId])
  @@index([workspaceId, documentId])
}

/**
 * TaxDocumentLink — scoped link from Document vault records to tax compliance entities.
 */
model TaxDocumentLink {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  entityType  String // RETURN_ACKNOWLEDGMENT | WITHHOLDING_CERTIFICATE | TAX_PAYMENT_PROOF
  entityKey   String // return period, certificate number, challan/proof id, etc.
  relation    String  @default("EVIDENCE") // ACKNOWLEDGMENT | CERTIFICATE | PROOF | EVIDENCE

  notes       String?
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, documentId, entityType, entityKey])
  @@index([workspaceId, entityType, entityKey, createdAt(sort: Desc)])
  @@index([workspaceId, documentId, createdAt(sort: Desc)])
}

model TaxImportBatch {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  templateType  String // WITHHOLDING_CERTIFICATES | FOREIGN_TAX_PAID | PRIOR_PERIOD_BALANCES
  sourceName    String?
  status        String   @default("COMPLETED") // COMPLETED | COMPLETED_WITH_ERRORS | FAILED

  submittedByUserId String?
  rowCount      Int      @default(0)
  successCount  Int      @default(0)
  warningCount  Int      @default(0)
  errorCount    Int      @default(0)

  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows TaxImportRow[]

  @@index([workspaceId, templateType, createdAt(sort: Desc)])
  @@index([workspaceId, status, createdAt(sort: Desc)])
}

model TaxImportRow {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  batchId       String
  batch         TaxImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  rowNumber     Int
  status        String // SUCCESS | WARNING | ERROR
  code          String? // VALIDATION_* | PARSE_* | BUSINESS_*
  message       String?
  fieldName     String?

  rawData       Json?
  normalizedData Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, batchId, rowNumber])
  @@index([workspaceId, status, createdAt(sort: Desc)])
}

/**
 * WorkspaceDocumentStorage — cached totals for quota checks.
 * bytesUsedTotal includes archived. bytesUsedActive excludes archived (optional UX metric).
 */
model WorkspaceDocumentStorage {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  bytesUsedTotal  BigInt @default(0)
  bytesUsedActive BigInt @default(0)

  updatedAt DateTime @updatedAt
}

/**
 * DocumentAuditEvent — document-specific trust and audit trail.
 */
model DocumentAuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  documentFileId String?
  documentFile   DocumentFile? @relation(fields: [documentFileId], references: [id], onDelete: SetNull)

  eventType   String
  actorUserId String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, eventType, createdAt(sort: Desc)])
  @@index([workspaceId, documentId])
}

// ==========================================
// 12. WORKFORCE MODULE
// ==========================================

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  HOLIDAY
  REMOTE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Department {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  description String?
  headId      String? // Optional: Employee ID of department head

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Designation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title String
  level Int? // Seniority level for hierarchy (1 = entry, 5 = senior)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@unique([workspaceId, title])
  @@index([workspaceId])
}

/**
 * Employee — Core workforce entity.
 * userId is optional: if set, this employee has a workspace user account
 * and can self-service their own attendance/leave.
 * If null, the employee is HR-managed only (contractors, external staff).
 */
model Employee {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Optional link to workspace user for self-service
  userId String? // links to User.id

  // Core identity
  firstName String
  lastName  String
  email     String?
  phone     String?
  avatarUrl String?

  // Employment details
  employeeCode String? // e.g., "EMP-001"
  status       EmploymentStatus @default(ACTIVE)
  joinDate     DateTime?
  exitDate     DateTime?
  location     String?

  // Organizational structure
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  managerId     String? // Self-referential: another Employee.id
  manager       Employee?  @relation("EmployeeReports", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Employee[] @relation("EmployeeReports")

  // Emergency contact
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]

  @@unique([workspaceId, employeeCode])
  @@index([workspaceId, status])
  @@index([workspaceId, departmentId])
  @@index([workspaceId, managerId])
  @@index([userId])
}

model AttendanceRecord {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date   DateTime // Date of attendance (day-level)
  status AttendanceStatus @default(PRESENT)

  checkInAt  DateTime?
  checkOutAt DateTime?
  notes      String?

  /// Whether this record was entered by the employee (self) or by HR/manager
  isManagerEntered Boolean @default(false)
  managedByUserId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([workspaceId, date])
  @@index([workspaceId, employeeId, date])
  @@index([workspaceId, status])
}

model LeaveType {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String // "Annual Leave", "Sick Leave", "Casual Leave"
  code        String // "AL", "SL", "CL"
  description String?
  color       String  @default("indigo") // Tailwind color name for calendar dots
  defaultDays Int     @default(0) // Default annual entitlement
  isActive    Boolean @default(true)
  isPaid      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@unique([workspaceId, code])
  @@index([workspaceId, isActive])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  startDate DateTime
  endDate   DateTime
  days      Float    @default(1) // Supports 0.5 for half-day
  reason    String?

  status LeaveRequestStatus @default(PENDING)

  approvedByUserId String?
  approvedAt       DateTime?
  rejectionReason  String?

  /// Task record ID for approval queue integration
  taskId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, employeeId, status])
  @@index([workspaceId, startDate, endDate])
  @@index([workspaceId, status])
  @@index([workspaceId, leaveTypeId])
}

model LeaveBalance {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  year      Int // e.g., 2026
  entitled  Float @default(0)
  used      Float @default(0)
  pending   Float @default(0) // Submitted but not yet approved
  remaining Float @default(0) // Computed: entitled - used - pending

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([workspaceId, year])
  @@index([workspaceId, employeeId])
}

model WorkforceHoliday {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  date        DateTime
  isRecurring Boolean  @default(true) // true = repeats every year on same date
  year        Int? // null if isRecurring, else specific year

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, date])
  @@index([workspaceId, year])
}

model WorkSchedule {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// JSON array of working days: ["MON","TUE","WED","THU","FRI"]
  workingDays   String @default("[\"MON\",\"TUE\",\"WED\",\"THU\",\"FRI\"]")
  workStartTime String @default("09:00")
  workEndTime   String @default("18:00")
  timeZone      String @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
