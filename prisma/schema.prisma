generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" // Or "file:../dev.db" depending on your folder structure
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

/**
 * BusinessRoleEnum — authoritative ERP role type at the schema level.
 * Validated by Prisma ORM; stored as TEXT in SQLite.
 * The old `role` String field is kept for JWT/session compatibility.
 * Server-side enforcement uses `businessRole` via a fresh DB lookup.
 */
enum BusinessRoleEnum {
  OWNER
  ADMIN
  FINANCE_MANAGER
  ACCOUNTANT
  SALES_MANAGER
  OPERATIONS_MANAGER
  INVENTORY_MANAGER
  STAFF
  VIEWER
}

enum CashForecastHorizonType {
  DAILY_30
  WEEKLY_13
  MONTHLY_12
}

enum CashForecastScenarioTag {
  BASE
  BEST_CASE
  WORST_CASE
}

enum CashForecastDirection {
  INFLOW
  OUTFLOW
}

enum CashForecastSourceType {
  INVOICE
  RETAINER
  EXPENSE
  PURCHASE_ORDER
  BANK_TRANSACTION
  MANUAL
  SERVICE_ORDER
  TAX
  PAYROLL
}

enum CashForecastClassification {
  ACTUAL
  COMMITTED
  EXPECTED
  PREDICTED
  MANUAL
}

enum CashForecastGeneratedBy {
  SYSTEM
  USER
  RULE_CHANGE
  DATA_IMPORT
}

enum CashForecastRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkspaceTaxMode {
  AUTO
  AUTO_WITH_OVERRIDE
  MANUAL
}

enum TaxOverrideScopeType {
  GLOBAL
  COUNTRY
  REGION
  SERVICE
  CUSTOMER
}

enum TaxResolutionSource {
  MANUAL_OVERRIDE
  WORKSPACE_RULE
  PROVIDER
  FALLBACK
}

enum TaxReturnFamily {
  INDIA_TDS_QTR
}

enum TaxReadinessSeverity {
  INFO
  WARNING
  CRITICAL
}

enum TaxReturnStatus {
  DRAFT
  BLOCKED
  NEEDS_REVIEW
  READY
  FILED
}

enum TaxReadinessBlockerStatus {
  OPEN
  RESOLVED
}

enum FilingFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum TaxObligationStatus {
  OPEN
  READY
  OVERDUE
  FILED
}

enum ComplianceTaskStatus {
  PENDING
  COMPLETED
  DISMISSED
}

enum AccountingEventType {
  INVOICE_CREATED
  PAYMENT_CAPTURED
  REFUND_ISSUED
  CREDIT_NOTE_ISSUED
  CHARGEBACK_RECORDED
  FX_CONVERSION_RECORDED
  WRITE_OFF_RECORDED
  MANUAL_ADJUSTMENT
}

enum AccountingLineSide {
  DEBIT
  CREDIT
}

enum ProposalConversionType {
  ONE_TIME_INVOICE
  RETAINER
  SHOP_ORDER
  MILESTONE_BILLING
}

enum DistributorCommissionStatus {
  PENDING
  APPROVED
  PAID
  VOID
  CLAWED_BACK
}

enum ResellerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CouponAudience {
  RESELLER
  CUSTOMER_REFERRAL
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

enum LeadStage {
  LEAD
  QUALIFIED
  WON
  LOST
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  VOID
}

/// LIST = margin % × catalog list price; PAID = margin % × amount customer paid
enum DistributorMarginBasis {
  LIST
  PAID
}

enum DistributorPayoutStatus {
  DRAFT
  PAID
}

// ==========================================
// DISTRIBUTOR / CHANNEL PARTNERS (subscription coupons & margins)
// ==========================================

model Distributor {
  id     String @id @default(cuid())
  name   String
  email  String @unique
  status String @default("ACTIVE") // ACTIVE | INACTIVE

  /// Default partner margin % of list price (catalog). Per-coupon can override.
  defaultMarginPercent Decimal @default(0)

  /// Default: commission = margin% × list; PAID = margin% × net paid
  defaultMarginBasis DistributorMarginBasis @default(LIST)

  /// Optional JSON map of interval -> margin percent, e.g. {"MONTHLY":12,"YEARLY":10}
  marginByPlanJson Json?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupons      DistributorCoupon[]
  attributions DistributorAttribution[]
  commissions  DistributorCommission[]
  payouts      DistributorPayout[]
  auditLogs    DistributorAuditLog[]
  partnerUsers User[]
}

model DistributorCoupon {
  id String @id @default(cuid())

  distributorId String
  distributor     Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  /// Uppercase normalized code (e.g. PARTNER-ABC123)
  code String @unique

  /// Customer-facing discount % off list subscription price at checkout
  customerDiscountPercent Decimal @default(0)

  /// Partner margin % of list price for commission reporting (independent of discount)
  marginPercent Decimal @default(0)

  /// Overrides distributor default when set
  marginBasis DistributorMarginBasis?

  /// Comma-separated: PRO, TEAM or ALL
  allowedTiers String @default("PRO,TEAM")

  firstPurchaseOnly Boolean @default(false)

  startsAt DateTime?
  endsAt   DateTime?

  isActive Boolean @default(true)
  maxUses  Int?
  usedCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributions DistributorAttribution[]
  commissions  DistributorCommission[]
  billingTransactions BillingTransaction[]

  @@index([distributorId, isActive])
}

model DistributorPayout {
  id String @id @default(cuid())

  distributorId String
  distributor     Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  status      DistributorPayoutStatus @default(DRAFT)
  periodLabel String?
  totalAmount Decimal               @default(0)
  method      String?
  reference   String?
  paidAt      DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions DistributorCommission[]

  @@index([distributorId, status, createdAt])
}

model DistributorAuditLog {
  id String @id @default(cuid())

  distributorId String?
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  actorEmail String?
  action     String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([distributorId, createdAt])
  @@index([createdAt])
}

/// One workspace is attributed to at most one distributor (latest applied coupon wins).
model DistributorAttribution {
  id String @id @default(cuid())

  couponId String
  coupon     DistributorCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  distributorId String
  distributor     Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  appliedAt DateTime @default(now())

  @@index([distributorId, appliedAt])
}

/// One commission row per successful subscription payment (billing transaction).
model DistributorCommission {
  id String @id @default(cuid())

  distributorId String
  distributor     Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  couponId String?
  coupon     DistributorCoupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  billingTransactionId String @unique
  billingTransaction   BillingTransaction @relation(fields: [billingTransactionId], references: [id], onDelete: Cascade)

  /// Catalog list amount (INR) before distributor coupon discount
  listAmount Decimal @default(0)
  /// Amount the customer actually paid (INR)
  paidAmount Decimal @default(0)
  /// Snapshot of margin % used for this sale
  marginPercent Decimal @default(0)
  /// Commission = listAmount * marginPercent / 100
  commissionAmount Decimal @default(0)

  status DistributorCommissionStatus @default(PENDING)

  /// Snapshot: LIST or PAID basis used for this row
  marginBasisUsed DistributorMarginBasis @default(LIST)

  payoutId String?
  payout   DistributorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  clawbackReason String?
  reversedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([distributorId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([status, distributorId])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ReferralRewardType {
  FREE_MONTH
  WALLET_CREDIT
}

enum ReferralRewardStatus {
  PENDING
  APPROVED
  APPLIED
  CANCELLED
}

// ==========================================
// 1. AUTHENTICATION (NextAuth Standard)
// ==========================================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String? // This acts as the Avatar URL
  role          String    @default("USER") // "USER", "ADMIN"

  // --- DEMO LIFECYCLE ---
  isDemo          Boolean   @default(false)
  demoTemplateKey String?
  demoExpiresAt   DateTime?

  // --- NEW: PERSONAL PREFERENCES ---
  theme              String @default("system") // "light", "dark", "system"
  dateFormat         String @default("DD/MM/YYYY")
  timeZone           String @default("Asia/Kolkata")
  locale             String @default("en-IN") // Formatting rules (e.g., en-IN, en-US)
  currencyFormat     String @default("INR") // Currency symbol/math (e.g., INR, USD)
  defaultLandingPage String @default("/dashboard") // e.g., "/dashboard", "/invoice", "/clients"

  // --- NOTIFICATION SETTINGS ---
  transactionalAlerts Boolean @default(true) // E.g., "Invoice Paid" alerts
  marketingEmails     Boolean @default(false) // Product updates/news
  weeklyReport        Boolean @default(true) // AI Financial Summary emails
  // Granular channel toggles (user-configurable per channel)
  notifyEmail         Boolean @default(true)
  notifyPush          Boolean @default(true)
  notifyInApp         Boolean @default(true)

  // --- RELATIONS ---
  accounts           Account[]
  sessions           Session[]
  workspaces         WorkspaceUser[]
  appActivities      AppActivityLog[]    @relation("AppActivityActor")
  pushSubscriptions  PushSubscription[]
  inAppNotifications InAppNotification[]
  onboarding         UserOnboarding?
  userPreference     UserPreference?

  /// When set, this user can access the distributor partner portal for this partner record
  distributorPartnerId String?
  distributorPartner   Distributor? @relation(fields: [distributorPartnerId], references: [id], onDelete: SetNull)

  referralProfile    CustomerReferralProfile?

  @@index([distributorPartnerId])
}

model UserOnboarding {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona        String?
  isFirstLogin   Boolean   @default(true)
  completedSteps String    @default("[]")
  dismissedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isFirstLogin])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// 2. MULTI-TENANCY & BILLING (The "Workspace")
// ==========================================
model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // --- DEMO LIFECYCLE ---
  isDemo          Boolean   @default(false)
  demoTemplateKey String?
  demoExpiresAt   DateTime?

  // --- NEW: GLOBALIZATION STATE ---
  isSetupComplete Boolean @default(false) // Triggers the Popup Wizard
  countryCode     String  @default("IN") // ISO 2-letter code (US, AE, GB, IN)
  baseCurrency    String  @default("INR") // Functional currency for reports

  // --- EXISTING BILLING ---
  subscriptionStatus   String    @default("FREE") // "TRIALING", "PRO", "FREE", "SUSPENDED"
  subscriptionEndsAt   DateTime?
  planTier             String    @default("FREE") // "FREE", "PRO", "TEAM"
  currentMonthInvoices Int       @default(0)
  seatAddonCount       Int       @default(0) // future: purchased additional seats

  planInterval      String? // "MONTHLY", "QUARTERLY", "YEARLY"
  paymentMethodMask String? // e.g., "•••• 4242" or "user@upi"
  billingProviderId String? // Stripe/Razorpay Customer ID

  /// True after at least one successful paid subscription charge (for partner first-purchase coupons)
  hasEverSubscribed Boolean @default(false)
  signupIntentJson  String?

  updatedAt DateTime @default(now()) @updatedAt

  // RELATIONS
  users                           WorkspaceUser[]
  businessProfile                 BusinessProfile?
  clients                         Client[]
  invoices                        Invoice[]
  billingTransactions             BillingTransaction[]
  resellerLeads                  ResellerLead[]
  customerReferralProfiles       CustomerReferralProfile[]
  referralRedemptions            CustomerReferralRedemption[]
  referralRewards                CustomerReferralReward[]       @relation("ReferrerWorkspace")
  expenses                        Expense[]
  withholdingEvents               WithholdingEvent[]
  taxCreditEvents                 TaxCreditEvent[]
  taxCreditLedgerEntries          TaxCreditLedgerEntry[]
  taxReturnPeriods                TaxReturnPeriod[]
  bankTransactions                BankTransaction[]
  bankAccounts                    BankAccount[]
  bankImportBatches               BankImportBatch[]
  workspaceReconciliationSettings WorkspaceReconciliationSettings?
  expenseReconciliationCategories ExpenseReconciliationCategory[]
  bankReconciliationRules         BankReconciliationRule[]
  investments                     Investment[]
  serviceTemplates                ServiceTemplate[]
  proposals                       Proposal[]
  proposalConversions             ProposalConversion[]
  billingMilestones               BillingMilestone[]
  retainers                       Retainer[]
  tasks                           Task[]
  invoiceIdempotencies            InvoiceIdempotency[]
  financialOperationLocks         FinancialOperationIdempotency[]
  taxPreference                   WorkspaceTaxPreference?
  workspaceTaxOverrides           WorkspaceTaxOverride[]
  taxRateOverrides                TaxRateOverride[]
  taxRateOverrideAuditLogs        TaxRateOverrideAuditLog[]
  taxDecisionAuditLogs            TaxDecisionAuditLog[]
  taxableEvents                   TaxableEvent[]
  taxDeterminations               TaxDetermination[]
  taxComponentLines               TaxComponentLine[]
  taxAuditEvents                  TaxAuditEvent[]
  taxOperationIdempotencies       TaxOperationIdempotency[]
  taxReferenceEntries             TaxReferenceEntry[]
  taxPeriods                      TaxPeriod[]
  taxForms                        TaxForm[]
  taxReturns                      TaxReturn[]
  taxReturnFieldValues            TaxReturnFieldValue[]
  taxReadinessChecks              TaxReadinessCheck[]
  taxReadinessBlockers            TaxReadinessBlocker[]
  fileImportAuditLogs             FileImportAuditLog[]
  appActivityLogs                 AppActivityLog[]
  workspaceInvites                WorkspaceInvite[]
  distributorAttribution         DistributorAttribution?
  distributorCommissions         DistributorCommission[]
  accountingTransactions          AccountingTransaction[]
  accountingIntegrityRuns         AccountingIntegrityRun[]
  accountingViolationReports      AccountingViolationReport[]
  cashForecastSnapshots           CashForecastSnapshot[]
  cashForecastAssumptions         CashForecastAssumption[]
  cashForecastAdjustments         CashForecastManualAdjustment[]
  cashForecastLineItemPlans       CashForecastLineItemPlan[]
  cashForecastAlertPreferences    CashForecastAlertPreference[]
  clientPaymentBehaviors          ClientPaymentBehavior[]
  rbacAuditLogs                   RbacAuditLog[]

  // IMS Relations
  products           Product[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  accountingEntries  AccountingEntry[]
  shopOrders         ShopOrder[]

  // Workforce Module
  workspaceModules  WorkspaceModule[]
  importRuns        ImportRun[]
  employees         Employee[]
  departments       Department[]
  designations      Designation[]
  attendanceRecords AttendanceRecord[]
  leaveTypes        LeaveType[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  workforceHolidays WorkforceHoliday[]
  workSchedules     WorkSchedule[]
  payrollSettings   PayrollSettings?
  payComponents     PayrollPayComponent[]
  payrollPeriods    PayrollPeriod[]
  payrollRuns       PayrollRun[]
  payrollPostings   PayrollPosting[]

  // Document Vault (optional module)
  documents               Document[]
  documentFiles           DocumentFile[]
  documentOcrJobs         DocumentOcrJob[]
  documentExtractedFields DocumentExtractedField[]
  documentLinks           DocumentLink[]
  taxDocumentLinks        TaxDocumentLink[]
  taxImportBatches        TaxImportBatch[]
  taxImportRows           TaxImportRow[]
  documentAuditEvents     DocumentAuditEvent[]
  documentStorage         WorkspaceDocumentStorage?
  taxRegistrations        WorkspaceTaxRegistration[]
  filingCalendarRules     FilingCalendarRule[]
  taxObligations          TaxObligation[]
  taxObligationPeriods    TaxObligationPeriod[]
  complianceTasks         ComplianceTask[]

  @@index([isDemo])
  @@index([demoExpiresAt])
  @@index([demoTemplateKey])
}

model ResellerAccount {
  id String @id @default(cuid())

  name  String
  email String @unique

  status                   ResellerStatus @default(ACTIVE)
  defaultCustomerDiscount  Decimal        @default(25)
  defaultCommissionPercent Decimal        @default(12.5)
  payoutTerms              String         @default("Net 30")
  notes                    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupons     ResellerCoupon[]
  leads       ResellerLead[]
  commissions ResellerCommission[]
  payouts     ResellerPayout[]
}

model ResellerCoupon {
  id String @id @default(cuid())

  resellerId String
  reseller   ResellerAccount @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  code             String             @unique
  audience         CouponAudience     @default(RESELLER)
  discountType     CouponDiscountType @default(PERCENT)
  discountValue    Decimal            @default(25)
  commissionPercent Decimal           @default(12.5)
  firstPurchaseOnly Boolean           @default(true)
  firstYearOnly     Boolean           @default(true)
  isActive          Boolean           @default(true)
  maxUses           Int?
  usedCount         Int               @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads ResellerLead[]

  @@index([resellerId, isActive])
}

model ResellerLead {
  id String @id @default(cuid())

  resellerId String
  reseller   ResellerAccount @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  couponId String?
  coupon   ResellerCoupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  workspaceId String @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  stage         LeadStage @default(LEAD)
  conversionAt  DateTime?
  closedDealValue Decimal?
  notes         String?
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions ResellerCommission[]

  @@index([resellerId, stage, createdAt])
}

model ResellerPublicQuery {
  id String @id @default(cuid())

  fullName String
  email    String
  company  String?
  phone    String?
  website  String?

  monthlyClientLeads Int?
  message            String
  budgetBand         String?
  status             LeadStage @default(LEAD)
  source             String    @default("public_reseller_page")
  metadata           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model ResellerCommission {
  id String @id @default(cuid())

  resellerId String
  reseller   ResellerAccount @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  leadId String?
  lead   ResellerLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  billingTransactionId String?
  billingTransaction   BillingTransaction? @relation(fields: [billingTransactionId], references: [id], onDelete: SetNull)

  dealAmount         Decimal @default(0)
  commissionPercent  Decimal @default(0)
  commissionAmount   Decimal @default(0)
  status             CommissionStatus @default(PENDING)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payoutId String?
  payout   ResellerPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([resellerId, status, createdAt])
}

model ResellerPayout {
  id String @id @default(cuid())

  resellerId String
  reseller   ResellerAccount @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  payoutDate DateTime?
  method     String?
  reference  String?
  totalAmount Decimal @default(0)
  status      PayoutStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions ResellerCommission[]

  @@index([resellerId, status, createdAt])
}

model CustomerReferralProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  code           String  @unique
  isActive       Boolean @default(true)
  shareLink      String?
  totalReferrals Int     @default(0)
  successfulReferrals Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CustomerReferralRedemption[]

  @@index([workspaceId, isActive])
}

model CustomerReferralRedemption {
  id String @id @default(cuid())

  profileId String
  profile   CustomerReferralProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  referredWorkspaceId String @unique
  referredWorkspace   Workspace @relation(fields: [referredWorkspaceId], references: [id], onDelete: Cascade)

  friendDiscountPercent Decimal @default(20)
  convertedAt           DateTime?
  metadata              Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewards CustomerReferralReward[]

  @@index([profileId, createdAt])
}

model CustomerReferralReward {
  id String @id @default(cuid())

  redemptionId String
  redemption   CustomerReferralRedemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)

  referrerWorkspaceId String
  referrerWorkspace   Workspace @relation("ReferrerWorkspace", fields: [referrerWorkspaceId], references: [id], onDelete: Cascade)

  rewardType ReferralRewardType   @default(WALLET_CREDIT)
  rewardStatus ReferralRewardStatus @default(PENDING)
  walletCreditAmount Decimal?
  freeMonthsCount     Int?
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerWorkspaceId, rewardStatus, createdAt])
}

model DemoProvisionAttempt {
  id String @id @default(cuid())

  createdAt DateTime @default(now())

  ip          String?
  fingerprint String?
  templateKey String?

  isAllowed         Boolean @default(false)
  blockReason       String?
  retryAfterSeconds Int?

  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([fingerprint, createdAt])
  @@index([templateKey, createdAt])
}

model AppActivityLog {
  id String @id @default(cuid())

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  actorUserId String?
  actorUser   User?   @relation("AppActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String?

  action     String
  entityType String?
  entityId   String?

  status   String // "SUCCESS" | "FAILURE" | "WARNING" | "INFO"
  metadata Json?

  ipAddress     String?
  userAgent     String?
  correlationId String?

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}

model BillingTransaction {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  transactionDate   DateTime @default(now())
  amount            Decimal  @default(0)
  status            String   @default("PAID") // "PAID", "PENDING", "FAILED", etc.
  description       String
  providerReference String?
  receiptUrl        String?

  /// Catalog subscription list price (INR) for this charge before distributor coupon discount.
  subscriptionListAmount Decimal?
  distributorCouponId     String?
  distributorCoupon       DistributorCoupon? @relation(fields: [distributorCouponId], references: [id], onDelete: SetNull)

  distributorCommission DistributorCommission?

  /// ISO 4217 for subscription charges (checkout currency)
  subscriptionCurrency String? @default("INR")
  /// e.g. MONTHLY, YEARLY — snapshot at payment time
  subscriptionInterval String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resellerCommissions ResellerCommission[]

  @@unique([workspaceId, providerReference])
  @@index([workspaceId, transactionDate])
  @@index([distributorCouponId])
}

model FinancialOperationIdempotency {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operation      String
  idempotencyKey String
  requestHash    String
  responseBody   Json?
  status         String    @default("PENDING") // "PENDING" | "CONSUMED"
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, operation, idempotencyKey])
  @@index([workspaceId, operation, expiresAt])
}

model AccountingTransaction {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  eventType       AccountingEventType
  eventOccurredAt DateTime
  postedAt        DateTime            @default(now())
  postingCurrency String
  exchangeRate    Decimal?
  description     String?

  sourceTable      String
  sourceId         String
  sourceRef        String?
  requestId        String?
  jobId            String?
  statementBatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries AccountingEntry[]

  @@unique([workspaceId, sourceTable, sourceId, eventType])
  @@index([workspaceId, eventType, postedAt])
  @@index([workspaceId, sourceTable, sourceId])
  @@index([requestId])
  @@index([jobId])
}

model AccountingEntry {
  id String @id @default(cuid())

  transactionId String
  transaction   AccountingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  lineNumber  Int
  accountCode String
  side        AccountingLineSide
  amount      Decimal
  currency    String
  postedAt    DateTime
  isPosted    Boolean            @default(true)

  createdAt DateTime @default(now())

  @@unique([transactionId, lineNumber])
  @@index([workspaceId, accountCode, postedAt])
  @@index([workspaceId, transactionId])
}

model AccountingIntegrityRun {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  runType     String    @default("NIGHTLY")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("RUNNING")
  summary     Json?

  violations AccountingViolationReport[]

  @@index([workspaceId, startedAt(sort: Desc)])
}

model AccountingViolationReport {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  runId String
  run   AccountingIntegrityRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  invariantCode String
  severity      String   @default("ERROR")
  details       Json
  detectedAt    DateTime @default(now())

  @@index([workspaceId, detectedAt(sort: Desc)])
  @@index([runId, invariantCode])
}

model WorkspaceUser {
  id          String @id @default(cuid())
  userId      String
  workspaceId String

  /// Legacy role field — kept for JWT/session compatibility.
  /// Server-side enforcement uses `businessRole` via fresh DB lookup in lib/rbac.ts.
  role String @default("OWNER") // "OWNER", "MEMBER"

  /// ERP business role — Prisma-enum-validated, authoritative for permissions.
  /// Null means the role has not been migrated yet; lib/rbac.ts falls back to `role`.
  businessRole BusinessRoleEnum? @default(OWNER)

  /// Whether this member currently has active workspace access.
  /// Deactivated members retain their record for audit trail but cannot access the workspace.
  /// Deactivated members do NOT count toward the seat limit.
  isActive Boolean @default(true)

  /// When this member joined (accepted invite or was auto-provisioned).
  joinedAt DateTime @default(now())

  /// Last time this member was seen active (updated by auth callbacks).
  lastActiveAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, isActive])
  @@index([workspaceId, businessRole])
}

model WorkspaceInvite {
  id          String @id @default(cuid())
  workspaceId String
  email       String

  /// The ERP business role this invite will grant upon acceptance.
  role         String           @default("STAFF") // legacy — kept for email template compatibility
  businessRole BusinessRoleEnum @default(STAFF)

  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId, expiresAt])
}

// ==========================================
// 3. SECURED BUSINESS DATA
// ==========================================

model BusinessProfile {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  companyName    String
  proprietorName String
  address        String
  email          String
  phone          String?
  website        String?

  invoiceTheme String @default("DESIGN_1") // "DESIGN_1" or "DESIGN_2"

  // --- DYNAMIC TAX LABELS ---
  // In the UI, instead of "Enter GST", we show "Enter {taxLabel}"
  taxLabel     String @default("GST") // "VAT", "Sales Tax", "GST"
  taxIdLabel   String @default("GSTIN") // "TRN", "EIN", "GSTIN"
  routingLabel String @default("IFSC Code") // "SWIFT", "Sort Code", "ABA"

  // Compliance (Keeping legacy names for no-break compatibility)
  panNumber   String // Acts as Primary Tax ID
  udyamNumber String? // Acts as Secondary Business ID
  gstin       String? // Acts as the Regional Tax ID

  // Banking
  bankName      String
  accountName   String
  accountNumber String
  ifscCode      String // General routing code
  primaryBankAccountId String?
  primaryBankAccount   BankAccount? @relation("PrimaryRemittanceBankAccount", fields: [primaryBankAccountId], references: [id], onDelete: SetNull)

  logoUrl        String?
  signatureUrl   String?
  groqApiKey     String?
  defaultSacCode String? @default("998313") // Default IT Consulting if not specified
  defaultTaxRate Float?

  // PAYMENT GATEWAY (Per-Tenant Razorpay Keys — PRO users only)
  razorpayKeyId     String? // Plain text (publishable key, e.g. rzp_live_xxx)
  razorpayKeySecret String? // AES-256-GCM encrypted blob (NEVER stored plain)

  // PAYMENT GATEWAY — Stripe (PRO users only, global)
  stripePublishableKey String? // Plain text (pk_live_xxx)
  stripeSecretKey      String? // AES-256-GCM encrypted blob (NEVER stored plain)
  defaultGateway       String? @default("RAZORPAY") // "RAZORPAY" | "STRIPE"

  // PUBLIC SHOP (E-Store)
  shopSlug        String? @unique // URL slug e.g. "bababuilds" → /shop/bababuilds
  shopTagline     String? // Hero subtitle shown on shop page
  shopEnabled     Boolean @default(false) // Master on/off for the public shop
  shopAccentColor String? @default("#6366f1") // HSL accent color for shop branding

  // PUBLIC SHOP — content blocks (admin-editable, rendered on /shop/<slug>)
  shopAnnouncement String? // Optional thin banner shown above the hero (e.g. promo / shipping notice)
  shopAboutMd      String? // Markdown body for the "About Us" section (sanitized at render time)
  shopFooterNote   String? // Optional fine-print / shop-specific footer note (plain text)
  shopSocialJson   String? // JSON: array of { platform, url } pairs (instagram, facebook, x, linkedin, youtube, whatsapp, custom)
  shopFaqJson      String? // JSON: array of { q, a } FAQ entries (capped server-side)
  shopShowAiAssist Boolean @default(true) // Show in-shop "AI Assist" lead-capture drawer for buyers

  // EMAIL SERVER (SMTP)
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPassword  String?
  smtpFromEmail String?

  updatedAt DateTime @updatedAt

  @@index([primaryBankAccountId])
}

model Client {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name    String
  address String
  country String
  taxId   String?
  email   String?
  phone   String?
  logoUrl String?

  status String @default("ACTIVE") // "ACTIVE", "INACTIVE", "VIP"

  // "isExport" becomes "isTaxExempt" in global context
  isExport Boolean @default(true)

  createdAt       DateTime               @default(now())
  invoices        Invoice[]
  proposals       Proposal[]
  retainers       Retainer[]
  paymentBehavior ClientPaymentBehavior?

  @@unique([name, workspaceId])
  @@index([workspaceId])
}

model ClientPaymentBehavior {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  avgDaysToPay        Float?
  medianDaysToPay     Float?
  onTimeRate          Float?
  lateRate            Float?
  partialPaymentRate  Float?
  sampleInvoicesCount Int       @default(0)
  lastComputedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, lastComputedAt(sort: Desc)])
}

model Invoice {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  invoiceNumber       String
  financialYear       String
  billingMonth        String    @default("Unknown")
  invoiceDate         DateTime
  dueDate             DateTime?
  paymentTermsDays    Int?
  expectedPaymentDate DateTime?
  collectionRiskScore Float?
  lastReminderSentAt  DateTime?
  followUpStatus      String?
  clientName          String
  sacCode             String? // Removed the hardcoded @default("998313")
  serviceDescription  String

  subtotal    Decimal  @default(0)
  taxRate     Float    @default(0)
  taxAmount   Decimal  @default(0)
  grandTotal  Decimal  @default(0)
  taxMode     String   @default("exempt") // "taxable" | "exempt"
  totalAmount Decimal
  pdfPath     String
  createdAt   DateTime @default(now())

  status         InvoiceStatus @default(PENDING)
  amountReceived Decimal?
  dateReceived   DateTime?

  withholdingRatePercent    Decimal?
  withholdingAmount         Decimal?
  withholdingDeductedAt     DateTime?
  withholdingDepositedAt    DateTime?
  withholdingDepositDueAt   DateTime?
  withholdingReminderSentAt DateTime?

  providerGateway       String? // "RAZORPAY" or "STRIPE"
  providerPaymentLinkId String? // The ID of the generated payment link

  clientId             String?
  client               Client?               @relation(fields: [clientId], references: [id])
  idempotencyRecords   InvoiceIdempotency[]
  taxDecisionAuditLogs TaxDecisionAuditLog[]
  taxableEvents        TaxableEvent[]
  items                InvoiceItem[]
  linkedShopOrders     ShopOrder[]           @relation("ShopOrderLinkedInvoice")

  sourceProposalId      String?
  sourceProposal        Proposal?                     @relation("ProposalToInvoice", fields: [sourceProposalId], references: [id])
  proposalConversions   ProposalConversion[]
  billingMilestones     BillingMilestone[]
  withholdingEvents     WithholdingEvent[]
  bankTransactionSplits BankTransactionInvoiceSplit[]

  // Security: Two different workspaces can use invoice number "001"
  @@unique([invoiceNumber, workspaceId])
  @@index([financialYear])
  @@index([workspaceId])
  @@index([workspaceId, status, dueDate])
}

model WorkspaceTaxPreference {
  id                 String           @id @default(cuid())
  workspaceId        String           @unique
